script "Swordfish Delta Heat"

// A delta ladder on every bar. Each price row is a lane: a faint track the width of the bar, and on it a bar whose
// LENGTH is the row's delta in dollars (aggressive buys minus sells, times the row's price) against the candle's own
// largest row, which runs full length and is outlined. COLOUR strength compares across candles: it grows with the row's
// size against a typical bar's largest row, so a quiet candle's biggest row is full length but pale. Blue for net
// buying, red for net selling. The number sits across the whole lane so it stays legible however short the bar is. The
// chart's candle runs as a thin strip at the bar's left edge. Dollars, so the scale reads the same on any coin.
// Closed bars come from MMT's per-bar volume snapshots (the last 250 bars). MMT has no forming bar snapshot, so the
// live bar is built from the completed one-minute snapshots since it opened (exact per row, from any load time); the
// minute in progress, which has no snapshot, is added from live trades (no trade history is loaded), and the ladder is
// redrawn as trades arrive (at most once a second) and as each minute closes. When the bar closes, its own snapshot
// replaces that. A missing minute is skipped rather than ending the rebuild, and the title shows how many of the bar's
// minutes were found. The minute in which the script starts misses the trades before it went live until that
// minute's snapshot arrives.
// When the auto row size changes, every bar with a snapshot is redrawn at the new size, so all ladders on screen share
// one row height, and the colour scale is rebuilt from their largest rows at that size.
// Live reconstruction is limited to whole-minute chart timeframes from 1m through 4h.

input (
  input.section(title: "Rows")
  rowSize = input.float(0.0, title: "Row size in price (0 = auto)", min: 0.0, description: "Auto: the average range of the last 100 bars divided by Rows per typical bar, on a 1/2/2.5/5 grid and never below the tick size. It changes only when that range doubles or halves, and then every kept bar is redrawn at the new size. BTC 30m gives $50; high-volatility alts get proportionally bigger rows. Bigger rows leave more room for the numbers.")
  rowsPerBar = input.int(10, title: "Rows per typical bar (auto row size)", min: 3, max: 40)
  venue = input.select("Perps: Binance, Bybit, OKX", title: "Volume from", options: ["Chart venue", "Binance + Bybit perps", "Perps: Binance, Bybit, OKX"])
  input.section(title: "Look")
  showNumbers = input.bool(true, title: "Delta numbers")
  memory = input.int(200, title: "Colour scale: bars remembered", min: 20, max: 2000, description: "The typical largest row = the average, over this many bars, of each bar's largest row delta.")
  colorAt = input.float(2.0, title: "Full colour at x the typical largest row", min: 0.5, max: 10.0, description: "Bar length is relative to the candle's own largest row; colour strength compares rows across candles.")
  buyColor = input.color(color.rgb(92, 156, 255), title: "Buying")
  sellColor = input.color(color.rgb(255, 92, 102), title: "Selling")
)

setup (
  // row size grows with the square root of the timeframe, as a bar's typical range does
  tfSeconds = time.tfSeconds(context.timeframe)
  liveSupported = tfSeconds >= 60 && tfSeconds <= 14400 && math.floor(float(tfSeconds) / 60.0) * 60.0 == float(tfSeconds)
  tfScale = math.sqrt(float(tfSeconds) / 1800.0) ?? 1.0
  source = venue == "Binance + Bybit perps" ? markets.agg("binancef", "bybitf") : venue == "Chart venue" ? context.exchange : markets.agg("binancef", "bybitf", "okxf")
  useChart = venue == "Chart venue"
  useAll = venue == "Perps: Binance, Bybit, OKX"
)

data (
  chart = subscribe(data.ohlcv)
  vol = subscribe(data.volume, exchange: source)
  minutes = subscribe(data.volume, exchange: source, timeframe: 1m)
  // a one-minute clock, live only: reads from the chart's own handler are pinned to the bar's open, so the
  // forming bar is rebuilt from here as each minute closes
  clock = subscribe(data.ohlcv, timeframe: 1m, history: 0s)
  // live trades only (no history): the minute in progress has no snapshot yet, so it is built from these, and the
  // ladder is redrawn as they arrive instead of once a minute
  tBn = subscribe(data.trades, exchange: "binancef", history: 0s)
  tBb = subscribe(data.trades, exchange: "bybitf", history: 0s)
  tOk = subscribe(data.trades, exchange: "okxf", history: 0s)
  tCh = subscribe(data.trades, history: 0s)
)

plot ladder = plot.cells(title: "Delta ladder", columns: 1, scale: cellscale.unit, candles: cellcandles.side, format: cellformat.compact, decimals: 0, sign: true)

state (
  peaks = rolling<float>(memory)
  ranges = rolling<float>(100)
  step: float = 0.0
  lastDrawn: time? = null
  // the live bar's minute snapshots found and minutes elapsed, for the title (a shortfall is marked, not hidden)
  liveGot: int = 0
  liveWant: int = 0
  // each kept bar's largest row at the current row size, newest first, for rebuilding the colour scale on a resize
  resized = float[](1000)
  // live trades for the two most recent minutes (slot by minute parity): minute start (unix s), net and total coins
  // per row, and the rows touched; tStep is the row size they were bucketed with
  tm0: float = -1.0
  td0 = map<int, float>(4096)
  tv0 = map<int, float>(4096)
  tk0 = int[](4096)
  tm1: float = -1.0
  td1 = map<int, float>(4096)
  tv1 = map<int, float>(4096)
  tk1 = int[](4096)
  tStep: float = 0.0
  lastLiveSec: float = 0.0
)

// 1, 2, 2.5 or 5 times a power of ten, nearest above the target.
fn niceStep(target: float) -> float {
  let magnitude = math.pow(10.0, math.floor(math.log10(target) ?? 0.0)) ?? 1.0
  let n = target / magnitude
  return magnitude * (n <= 1.0 ? 1.0 : n <= 2.0 ? 2.0 : n <= 2.5 ? 2.5 : n <= 5.0 ? 5.0 : 10.0)
}

// A light version of a colour for text: halfway to white.
fn light(c: color) -> color {
  return color.gradient(0.5, 0.0, 1.0, c, color.rgb(255, 255, 255))
}

// One row of the ladder: the lane, the bar on it, then the number across the lane.
fn row(lo: float, hi: float, usd: float, ref: float, biggest: float, strongest: bool, at: time?) {
  let side = usd >= 0.0 ? buyColor : sellColor
  let share = math.min(1.0, math.abs(usd) / math.max(biggest, 0.000000001))
  let strength = math.min(1.0, math.abs(usd) / (ref * colorAt))
  ladder.cell(lo, hi, weight: 1.0, color: color.withAlpha(side, 16), align: align.left, time: at)
  ladder.cell(lo, hi, weight: math.max(share, 0.03), color: color.withAlpha(side, 70 + (int(185.0 * strength) ?? 0)), borderColor: strongest ? light(side) : null, align: align.left, time: at)
  if showNumbers {
    ladder.cell(lo, hi, weight: 1.0, color: color.rgb(0, 0, 0, 0), value: usd, textColor: color.rgb(250, 251, 253), align: align.left, time: at)
  }
}

// The live bar at second `sec`: completed minutes from MMT's one-minute snapshots, plus live trades for any buffered
// minute without its own snapshot (the minute in progress has none; the one just closed, or a skipped one, may not).
fn drawLive(sec: float) {
  if !liveSupported || step <= 0.0 { return }
  let tf = float(tfSeconds)
  let barU = math.floor(sec / tf) * tf
  let barStart = time.fromUnixSeconds(int(barU) ?? 0)
  let ref = math.max(peaks.avg() ?? 0.0, 0.000000001)
  let lowRow = 1000000000000.0
  let highRow = -1000000000000.0
  let span = int(tf / 60.0) ?? 1
  let more = true
  let sums = map<int, float>(4096)
  let vols = map<int, float>(4096)
  // every minute snapshot back to the bar's open: a missing minute (no trades, or no data) is skipped, not the end,
  // so earlier minutes are never discarded
  let got = 0
  // the minutes (unix s / 60) that have a snapshot: a buffered minute is replaced only by its own snapshot
  let seen = map<int, bool>(512)
  for back in 0..span {
    if more {
      let b = minutes.bucketsByStep(step, barsAgo: back)
      let bt = b != null ? float(time.unixSeconds(b.time) ?? 0) : -1.0
      if b != null && bt < barU {
        more = false
      } else if b != null {
        got += 1
        seen.set(int(bt / 60.0) ?? 0, true)
        for i in 0..b.len {
          let c = b.get(i)
          if c != null && c.total > 0.0 {
            let r = math.floor((c.from + c.to) / 2.0 / step)
            let k = int(r) ?? 0
            sums.set(k, (sums.get(k) ?? 0.0) + c.delta)
            vols.set(k, (vols.get(k) ?? 0.0) + c.total)
            lowRow = math.min(lowRow, r)
            highRow = math.max(highRow, r)
          }
        }
      }
    }
  }
  // live trades for minutes of this bar that have no snapshot of their own (yet)
  if tStep == step && tm0 >= barU && tm0 < barU + tf && !seen.has(int(tm0 / 60.0) ?? 0) {
    got += 1
    for k in tk0 {
      if k != null {
        sums.set(k, (sums.get(k) ?? 0.0) + (td0.get(k) ?? 0.0))
        vols.set(k, (vols.get(k) ?? 0.0) + (tv0.get(k) ?? 0.0))
        lowRow = math.min(lowRow, float(k))
        highRow = math.max(highRow, float(k))
      }
    }
  }
  if tStep == step && tm1 >= barU && tm1 < barU + tf && !seen.has(int(tm1 / 60.0) ?? 0) {
    got += 1
    for k in tk1 {
      if k != null {
        sums.set(k, (sums.get(k) ?? 0.0) + (td1.get(k) ?? 0.0))
        vols.set(k, (vols.get(k) ?? 0.0) + (tv1.get(k) ?? 0.0))
        lowRow = math.min(lowRow, float(k))
        highRow = math.max(highRow, float(k))
      }
    }
  }
  liveGot = got
  liveWant = int(math.floor((sec - barU) / 60.0)) + 1 ?? got
  if highRow >= lowRow {
    let rows = int(highRow - lowRow) ?? 0
    let biggest = 0.0
    let strongest = -1
    for j in 0..(rows + 1) {
      let r = lowRow + float(j)
      let usd = (sums.get(int(r) ?? 0) ?? 0.0) * (r + 0.5) * step
      if math.abs(usd) > biggest {
        biggest = math.abs(usd)
        strongest = j
      }
    }
    ladder.clear(time: barStart)
    for j in 0..(rows + 1) {
      let r = lowRow + float(j)
      let k = int(r) ?? 0
      if (vols.get(k) ?? 0.0) > 0.0 {
        row(r * step, (r + 1.0) * step, (sums.get(k) ?? 0.0) * (r + 0.5) * step, ref, biggest, j == strongest, barStart)
      }
    }
  }
}

// One live trade into its minute's slot; the ladder is redrawn at most once a second. A slot only moves forward: a late
// trade for a minute older than the one its slot holds is dropped rather than clearing the newer minute.
fn onLiveTrade(p: float, sz: float, buy: bool, tt: time) {
  if !liveSupported || step <= 0.0 || !(p > 0.0) || !(sz > 0.0) { return }
  if tStep != step {
    // a new row size: trades bucketed at the old one cannot be reused
    tm0 = -1.0
    tm1 = -1.0
    tStep = step
  }
  let sec = float(time.unixSeconds(tt) ?? 0)
  let m = math.floor(sec / 60.0) * 60.0
  let r = int(math.floor(p / step)) ?? 0
  let net = buy ? sz : -sz
  if math.floor(m / 60.0) - math.floor(m / 120.0) * 2.0 == 0.0 {
    if m < tm0 { return }
    if tm0 != m {
      td0.clear()
      tv0.clear()
      tk0.clear()
      tm0 = m
    }
    if !td0.has(r) && tk0.len < 4096 { tk0.push(r) }
    td0.set(r, (td0.get(r) ?? 0.0) + net)
    tv0.set(r, (tv0.get(r) ?? 0.0) + sz)
  } else {
    if m < tm1 { return }
    if tm1 != m {
      td1.clear()
      tv1.clear()
      tk1.clear()
      tm1 = m
    }
    if !td1.has(r) && tk1.len < 4096 { tk1.push(r) }
    td1.set(r, (td1.get(r) ?? 0.0) + net)
    tv1.set(r, (tv1.get(r) ?? 0.0) + sz)
  }
  if sec > lastLiveSec {
    lastLiveSec = sec
    drawLive(sec)
  }
}

on tBn.trade(tr) { if !useChart { onLiveTrade(tr.price, tr.size, tr.isBuy, tr.time) } }
on tBb.trade(tr) { if !useChart { onLiveTrade(tr.price, tr.size, tr.isBuy, tr.time) } }
on tOk.trade(tr) { if useAll { onLiveTrade(tr.price, tr.size, tr.isBuy, tr.time) } }
on tCh.trade(tr) { if useChart { onLiveTrade(tr.price, tr.size, tr.isBuy, tr.time) } }

// Each minute close also redraws, so a quiet market still advances.
on clock.close {
  let mt = clock.time
  if mt != null { drawLive(float(time.unixSeconds(mt) ?? 0)) }
}

// One closed bar's ladder from its snapshot `back` bars ago, at the current row size, against the colour reference.
// Returns the bar's largest row in dollars, or -1 when there is no snapshot.
fn drawSnapshot(back: int, ref: float, draw: bool) -> float {
  let b = vol.bucketsByStep(step, barsAgo: back)
  if b == null { return -1.0 }
  let biggest = 0.0
  let strongest = -1
  for i in 0..b.len {
    let c = b.get(i)
    if c != null && c.total > 0.0 {
      let usd = c.delta * (c.from + c.to) / 2.0
      if math.abs(usd) > biggest {
        biggest = math.abs(usd)
        strongest = i
      }
    }
  }
  if draw {
    let at = b.time
    ladder.clear(time: at)
    for i in 0..b.len {
      let c = b.get(i)
      if c != null && c.total > 0.0 {
        row(c.from, c.to, c.delta * (c.from + c.to) / 2.0, ref, biggest, i == strongest, at)
      }
    }
    if back == 0 { lastDrawn = at }
  }
  return biggest
}

// Closed bars: the volume snapshot, once per bar.
on chart.update {
  if chart.isLast {
    let liveText = liveWant > liveGot ? str.format("live ladder: {0} of {1} minutes (missing minutes: no trades or no data)", liveGot, liveWant) : "live ladder in real time"
    script.setTitle(liveSupported ? str.concat("Swordfish Delta Heat | ", liveText) : "Swordfish Delta Heat | closed bars only; live ladder needs whole-minute 1m-4h charts")
  }
}

on chart.close {
  let price = chart.close
  let hh = chart.high
  let ll = chart.low
  if hh != null && ll != null { ranges.push(hh - ll) }
  if price != null {
    // row size: fixed if set, else a tenth (by default) of the recent average bar range, changed only when that
    // range doubles or halves; before 20 bars, 0.06% of price scaled by the timeframe
    let avgRange = ranges.avg() ?? 0.0
    let tick = markets.tickSize(context.exchange, context.symbol) ?? 0.0
    let auto = math.max(ranges.len >= 20 && avgRange > 0.0 ? niceStep(avgRange / float(rowsPerBar)) : niceStep(price * 0.0006 * tfScale), tick)
    let before = step
    if rowSize > 0.0 {
      step = rowSize
    } else if step <= 0.0 || auto >= step * 2.0 || auto <= step / 2.0 {
      step = auto
    }
    // a new row size: redraw every kept bar at it, so no ladder keeps the old row height
    if before > 0.0 && step != before {
      resized.clear()
      let more = true
      for back in 0..1000 {
        if more {
          let biggest = drawSnapshot(back, 1.0, false)
          if biggest < 0.0 { more = false } else { resized.push(biggest) }
        }
      }
      peaks.clear()
      for j in 0..resized.len { peaks.push(resized[resized.len - 1 - j] ?? 0.0) }
      let ref = math.max(peaks.avg() ?? 0.0, 0.000000001)
      for back in 0..resized.len { drawSnapshot(back, ref, true) }
    }
  }
  if step > 0.0 {
    let b = vol.bucketsByStep(step)
    if b != null {
      let at = b.time
      let prior = lastDrawn
      if prior == null || (prior != null && at > prior) {
        // Dollars per row and the bar's strongest row.
        let biggest = 0.0
        let strongest = -1
        for i in 0..b.len {
          let c = b.get(i)
          if c != null && c.total > 0.0 {
            let usd = c.delta * (c.from + c.to) / 2.0
            if math.abs(usd) > biggest {
              biggest = math.abs(usd)
              strongest = i
            }
          }
        }
        peaks.push(biggest)
        let ref = math.max(peaks.avg() ?? biggest, 0.000000001)
        ladder.clear(time: at)
        for i in 0..b.len {
          let c = b.get(i)
          if c != null && c.total > 0.0 {
            row(c.from, c.to, c.delta * (c.from + c.to) / 2.0, ref, biggest, i == strongest, at)
          }
        }
        lastDrawn = at
      }
    }
  }
}
