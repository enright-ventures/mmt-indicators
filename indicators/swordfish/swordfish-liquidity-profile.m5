script "Swordfish Liquidity Profile"

// A volume profile over a chosen lookback, pinned to the left edge of the chart (a setting; the price labels of other
// scripts sit on the right), independent of what is on screen: buy and sell volume per price row, summed from MMT's
// volume snapshots (combined across the chosen perps by MMT). Rows inside the 70% volume value area are stronger and the
// point of control is outlined. The lookback is shown in the chart's top corner, with a dotted line at its start.
// Dynamic lookback: reaches back to a point of relevance, a major swing. A swing is major when price reverses by several
// average daily ranges, so it adapts to each coin. With 2 legs (the default) the window starts at the swing before the
// current leg began, so it spans the last full move and the current one.
// Liquidity gaps: runs of rows with little traded volume between rows with more, drawn as faint bands across the chart.
// A gap marks where little traded in the lookback, not resting orders or a level price must respect.
// Sources: hourly snapshots as far back as MMT keeps them, daily before that. MMT has no profile for a period still in
// progress, so up to the newest hour is not included.

input (
  input.section(title: "Profile")
  lookback = input.select("Dynamic", title: "Lookback", options: ["Dynamic", "14 days", "30 days", "90 days", "180 days"], description: "Dynamic reaches back to a major swing; see below.")
  swingMult = input.float(4.0, title: "Dynamic: a major swing reverses by (x the average daily range)", min: 1.0, max: 20.0)
  legs = input.int(2, title: "Dynamic: legs to include", min: 1, max: 6, description: "1 starts at the swing the current leg began from. 2 also includes the leg before it, so the window usually brackets price on both sides.")
  minDays = input.int(7, title: "Dynamic: at least (days)", min: 1, max: 90)
  rows = input.int(100, title: "Rows", min: 20, max: 200)
  venue = input.select("Perps: Binance, Bybit, OKX", title: "Volume from", options: ["Chart venue", "Binance + Bybit perps", "Perps: Binance, Bybit, OKX"])
  input.section(title: "Liquidity gaps")
  showGaps = input.bool(true, title: "Show gaps")
  gapPct = input.float(30.0, title: "A gap row trades below (% of the average row)", min: 1.0, max: 100.0)
  gapMinPct = input.float(0.3, title: "Minimum gap height (% of price)", min: 0.0, max: 10.0)
  gapsEach = input.int(2, title: "Gaps shown above and below price", min: 1, max: 6)
  input.section(title: "Look")
  side = input.select("Left", title: "Histogram at the", options: ["Left", "Right"], description: "Left keeps it clear of the price labels other scripts draw at the right edge.")
  widthPx = input.float(220.0, title: "Histogram width (pixels)", min: 40.0, max: 800.0)
  buyColor = input.color(color.rgb(31, 166, 125), title: "Buying")
  sellColor = input.color(color.rgb(214, 72, 92), title: "Selling", sameLine: true)
  gapColor = input.color(color.rgb(236, 190, 90), title: "Gaps", sameLine: true)
)

setup (
  source = venue == "Binance + Bybit perps" ? markets.agg("binancef", "bybitf") : venue == "Chart venue" ? context.exchange : markets.agg("binancef", "bybitf", "okxf")
  dynamic = lookback == "Dynamic"
  days = lookback == "14 days" ? 14 : lookback == "30 days" ? 30 : lookback == "90 days" ? 90 : 180
  barSpan = time.nominalDuration(context.timeframe)
  edgeAnchor = side == "Left" ? anchor.left : anchor.right
  cornerAnchor = side == "Left" ? anchor.topLeft : anchor.topRight
  labelAlign = side == "Left" ? "left" : "right"
  hourlyMax = 800
  dailyMax = 400
)

data (
  chart = subscribe(data.ohlcv)
  vh = subscribe(data.volume, exchange: source, timeframe: 1h, history: hourlyMax)
  vd = subscribe(data.volume, exchange: source, timeframe: 1D, history: dailyMax)
  // a one-minute clock, live only: picks up each newly completed hour, whatever the chart's timeframe
  clock = subscribe(data.ohlcv, timeframe: 1m, history: 0s)
)

window details = window(title: "Liquidity gaps") {
  gaps: table.new([
    table.col(title: "Gap", width: 1.4),
    table.col(title: "Height", align: align.right),
    table.col(title: "Distance", align: align.right),
    table.col(title: "Side", width: 0.6),
  ], title: "Gaps", capacity: 64),
  // Agent export: the point of control, value area and nearest gap each side as hidden series for
  // script_get_plot_values. Null when unavailable.
  export: chart.panel(chart),
}

plot (
  xPoc = plot.line(title: "x.poc", on: details.export)
  xVah = plot.line(title: "x.vah", on: details.export)
  xVal = plot.line(title: "x.val", on: details.export)
  xAboveLo = plot.line(title: "x.gap_above.lo", on: details.export)
  xAboveHi = plot.line(title: "x.gap_above.hi", on: details.export)
  xBelowLo = plot.line(title: "x.gap_below.lo", on: details.export)
  xBelowHi = plot.line(title: "x.gap_below.hi", on: details.export)
  xInsideLo = plot.line(title: "x.gap_inside.lo", on: details.export)
  xInsideHi = plot.line(title: "x.gap_inside.hi", on: details.export)
  xFromDays = plot.line(title: "x.lookback_days", on: details.export)
  xFromPrice = plot.line(title: "x.anchor_price", on: details.export)
)

state (
  // the profile's rows, lowest first, and the gaps found in them, lowest first
  rLo = float[](200)
  rHi = float[](200)
  rBuy = float[](200)
  rSell = float[](200)
  gLo = float[](64)
  gHi = float[](64)
  // the available periods, oldest first (daily, then hourly): start (unix s), high, low; and the swings found in them
  pT = float[](1300)
  pH = float[](1300)
  pL = float[](1300)
  swT = float[](300)
  swP = float[](300)
  // the window: its start (unix s), the swing price it starts at (0 when fixed), the average daily range
  fromT: float = 0.0
  fromP: float = 0.0
  adr: float = 0.0
  poc: float = 0.0
  vah: float = 0.0
  val: float = 0.0
  // the newest source period drawn (unix s), how many gaps sat above price when drawn, and the live bar's time
  drawnFor: float = -1.0
  dailyCut: float = 0.0
  drawnAbove: int = -1
  liveBar: time? = null
  hist = entities.boxPool(max: 410, anchor: edgeAnchor)
  bands = entities.boxPool(max: 12)
  tags = entities.labelPool(max: 12, anchor: edgeAnchor)
  // in a corner of the pane, so it stays on screen however the chart is zoomed
  span = entities.labelPool(max: 1, anchor: cornerAnchor)
  fromLine = entities.linePool(max: 1)
)

// A price with decimals for its size: 80,345 / 2,460.5 / 184.23 / 0.19345.
fn priceText(v: float) -> string {
  let a = math.abs(v)
  if a >= 10000.0 { return str.format("{0:,.0}", v) }
  if a >= 1000.0 { return str.format("{0:,.1}", v) }
  if a >= 100.0 { return str.format("{0:.2}", v) }
  if a >= 10.0 { return str.format("{0:.3}", v) }
  if a >= 1.0 { return str.format("{0:.4}", v) }
  return str.format("{0:.5}", v)
}

// Major swings in the periods (oldest first), into swT / swP: price must reverse by `size` (a fraction) from the running
// extreme to confirm that extreme as a swing, so highs and lows alternate and the extreme still running is not included.
fn findSwings(size: float) {
  swT.clear()
  swP.clear()
  if pT.len == 0 { return }
  let dir = 0
  let hi = pH[0] ?? 0.0
  let hiT = pT[0] ?? 0.0
  let lo = pL[0] ?? 0.0
  let loT = pT[0] ?? 0.0
  for i in 0..pT.len {
    let h = pH[i] ?? 0.0
    let l = pL[i] ?? 0.0
    let t = pT[i] ?? 0.0
    // a reversal is measured from an earlier period's extreme: one wide period's own high and low are not a swing
    if i > 0 && dir >= 0 && hi > 0.0 && (hi - l) / hi >= size && swT.len < 300 {
      swT.push(hiT)
      swP.push(hi)
      dir = -1
      lo = l
      loT = t
    } else if i > 0 && dir <= 0 && lo > 0.0 && (h - lo) / lo >= size && swT.len < 300 {
      swT.push(loT)
      swP.push(lo)
      dir = 1
      hi = h
      hiT = t
    } else {
      if h > hi && dir >= 0 {
        hi = h
        hiT = t
      }
      if l < lo && dir <= 0 {
        lo = l
        loT = t
      }
    }
  }
}

// The window's start for a dynamic lookback: the swing `count` legs back from now, but at least `minSpan` seconds before
// `now` and never later than the available history allows. Sets fromT and fromP (fromP 0 when no swing applies).
fn chooseStart(count: int, now: float, minSpan: float) {
  let k = swT.len - count
  fromT = pT.len > 0 ? pT[0] ?? now : now
  fromP = 0.0
  if k >= 0 {
    fromT = swT[k] ?? fromT
    fromP = swP[k] ?? 0.0
    // too recent: step back to older swings until the window is long enough
    let i = k
    let more = true
    for n in 0..swT.len {
      if more && now - (swT[i] ?? now) < minSpan {
        if i > 0 {
          i -= 1
          fromT = swT[i] ?? fromT
          fromP = swP[i] ?? 0.0
        } else {
          more = false
        }
      } else {
        more = false
      }
    }
  }
}

// The point of control and 70% value area of the current rows: from the heaviest row, add whichever neighbouring row is
// heavier until the area holds 70% of the volume (ties go lower).
fn computeArea() {
  let n = rLo.len
  poc = 0.0
  vah = 0.0
  val = 0.0
  if n == 0 { return }
  let total = 0.0
  let best = 0
  let most = -1.0
  for i in 0..n {
    let v = (rBuy[i] ?? 0.0) + (rSell[i] ?? 0.0)
    total += v
    if v > most {
      most = v
      best = i
    }
  }
  poc = ((rLo[best] ?? 0.0) + (rHi[best] ?? 0.0)) / 2.0
  let lo = best
  let hi = best
  let have = most
  let more = true
  for step in 0..n {
    if more && have < total * 0.7 {
      let down = lo > 0 ? (rBuy[lo - 1] ?? 0.0) + (rSell[lo - 1] ?? 0.0) : -1.0
      let up = hi < n - 1 ? (rBuy[hi + 1] ?? 0.0) + (rSell[hi + 1] ?? 0.0) : -1.0
      if down < 0.0 && up < 0.0 {
        more = false
      } else if up > down {
        hi += 1
        have += up
      } else {
        lo -= 1
        have += down
      }
    }
  }
  val = rLo[lo] ?? 0.0
  vah = rHi[hi] ?? 0.0
}

// Gaps in the current rows: runs of rows trading below `thr`, with rows at or above it on both sides (the thin tails
// at the top and bottom of the range are not gaps), at least `minHeight` tall.
fn findGaps(thr: float, minHeight: float) {
  gLo.clear()
  gHi.clear()
  let start = -1
  let seenHeavy = false
  for i in 0..rLo.len {
    let low = (rBuy[i] ?? 0.0) + (rSell[i] ?? 0.0) < thr
    if low {
      if seenHeavy && start < 0 { start = i }
    } else {
      if start >= 0 {
        let lo = rLo[start] ?? 0.0
        let hi = rLo[i] ?? 0.0
        if hi - lo >= minHeight && gLo.len < 64 {
          gLo.push(lo)
          gHi.push(hi)
        }
        start = -1
      }
      seenHeavy = true
    }
  }
}

// The nearest gap index above price (first with its low above price), or gLo.len when none.
fn firstAbove(price: float) -> int {
  for k in 0..gLo.len {
    if (gLo[k] ?? 0.0) > price { return k }
  }
  return gLo.len
}

// The index of the gap price sits inside, or -1.
fn insideGap(price: float) -> int {
  for k in 0..gLo.len {
    if (gLo[k] ?? 0.0) <= price && price <= (gHi[k] ?? 0.0) { return k }
  }
  return -1
}

// One gap as a faint band across the chart with its prices just inside the histogram.
fn drawGap(k: int, at: time) {
  let lo = gLo[k] ?? 0.0
  let hi = gHi[k] ?? 0.0
  bands.get("g", k).set(at, hi, at + barSpan, lo, color: color.withAlpha(gapColor, 26), extend: extend.both, zIndex: -1)
  tags.get("g", k).set(widthPx + 10.0, (lo + hi) / 2.0, str.format("gap {0} - {1}", priceText(lo), priceText(hi)), color: gapColor, size: 11, textAlign: labelAlign, zIndex: 5)
}

// The nearest gaps each side of price, drawn and listed, and the title.
fn drawGaps(price: float, at: time) {
  bands.clear("g")
  tags.clear("g")
  details.gaps.clear()
  let above = firstAbove(price)
  let inside = insideGap(price)
  if showGaps {
    if inside >= 0 { drawGap(inside, at) }
    let lowest = inside >= 0 ? inside : above
    for n in 0..gapsEach {
      let up = above + n
      if up < gLo.len && up != inside { drawGap(up, at) }
      let down = lowest - 1 - n
      if down >= 0 { drawGap(down, at) }
    }
  }
  for k in 0..gLo.len {
    let lo = gLo[k] ?? 0.0
    let hi = gHi[k] ?? 0.0
    let side = k == inside ? "inside" : lo > price ? "above" : "below"
    let dist = k == inside ? 0.0 : lo > price ? lo / price - 1.0 : hi / price - 1.0
    details.gaps.row(str.format("{0}", 1000 + k), str.format("{0} - {1}", priceText(lo), priceText(hi)), str.format("{0:.2%}", hi / lo - 1.0), str.format("{0:+.2%}", dist), side)
  }
  drawnAbove = above
  let ga = above < gLo.len ? str.format(" | gap above {0} - {1}", priceText(gLo[above] ?? 0.0), priceText(gHi[above] ?? 0.0)) : ""
  let below = (inside >= 0 ? inside : above) - 1
  let gb = below >= 0 ? str.format(" | gap below {0} - {1}", priceText(gLo[below] ?? 0.0), priceText(gHi[below] ?? 0.0)) : ""
  script.setTitle(str.concat(str.format("Swordfish Liquidity Profile | {0} | {1:.0}d | POC {2}", dynamic ? "dynamic" : "fixed", (float(time.unixSeconds(at) ?? 0) - fromT) / 86400.0, priceText(poc)), inside >= 0 ? " | inside a gap" : "", ga, gb))
}

// The periods available, oldest first: daily snapshots older than the hourly history, then hourly ones.
fn loadPeriods() {
  pT.clear()
  pH.clear()
  pL.clear()
  // the oldest hourly snapshot, and the first whole day it covers
  let oldest = 0.0
  for k in 0..hourlyMax {
    let t = vh.time(barsAgo: k)
    if t != null { oldest = float(time.unixSeconds(t) ?? 0) }
  }
  let cut = oldest > 0.0 ? math.ceil(oldest / 86400.0) * 86400.0 : 0.0
  dailyCut = cut
  let ranges = 0.0
  let rangeN = 0
  for j in 0..dailyMax {
    let k = dailyMax - 1 - j
    let t = vd.time(barsAgo: k)
    let sum = vd.summary(k)
    if t != null && sum != null {
      let ts = float(time.unixSeconds(t) ?? 0)
      if sum.maxPrice > 0.0 && k < 30 && sum.minPrice > 0.0 {
        ranges += (sum.maxPrice - sum.minPrice) / sum.minPrice
        rangeN += 1
      }
      if (oldest == 0.0 || ts < cut) && pT.len < 1300 {
        pT.push(ts)
        pH.push(sum.maxPrice)
        pL.push(sum.minPrice)
      }
    }
  }
  adr = rangeN > 0 ? ranges / float(rangeN) : 0.0
  for j in 0..hourlyMax {
    let k = hourlyMax - 1 - j
    let t = vh.time(barsAgo: k)
    if t != null {
      let ts = float(time.unixSeconds(t) ?? 0)
      let sum = vh.summary(k)
      if sum != null && ts >= cut && pT.len < 1300 {
        pT.push(ts)
        pH.push(sum.maxPrice)
        pL.push(sum.minPrice)
      }
    }
  }
}

// Rebuild the histogram when a new hour has completed: find the window, sum its snapshots on one row grid, draw.
fn refresh() {
  let newestT = vh.time()
  let at = liveBar
  if newestT == null || at == null { return }
  let newest = float(time.unixSeconds(newestT) ?? 0)
  if newest == drawnFor { return }
  loadPeriods()
  if pT.len == 0 { return }
  let now = float(time.unixSeconds(at) ?? 0)
  if dynamic {
    findSwings(swingMult * adr)
    chooseStart(legs, now, float(minDays) * 86400.0)
  } else {
    fromT = now - float(days) * 86400.0
    fromP = 0.0
  }
  // the window's price range and row size
  let top = 0.0
  let bottom = 0.0
  for i in 0..pT.len {
    if (pT[i] ?? 0.0) >= fromT {
      let h = pH[i] ?? 0.0
      let l = pL[i] ?? 0.0
      top = bottom == 0.0 ? h : math.max(top, h)
      bottom = bottom == 0.0 ? l : math.min(bottom, l)
    }
  }
  if !(top > bottom) || bottom <= 0.0 { return }
  let step = (top - bottom) / float(math.max(rows - 1, 1))
  let buys = map<int, float>(256)
  let sells = map<int, float>(256)
  // daily snapshots before the hourly history, then the hourly ones: each on the same grid of whole multiples of step
  for k in 0..dailyMax {
    let t = vd.time(barsAgo: k)
    if t != null {
      let ts = float(time.unixSeconds(t) ?? 0)
      if ts >= math.floor(fromT / 86400.0) * 86400.0 && ts < dailyCut {
        let b = vd.bucketsByStep(step, barsAgo: k)
        if b != null {
          for i in 0..b.len {
            let c = b.get(i)
            if c != null && c.total > 0.0 {
              let r = int(math.floor((c.from + c.to) / 2.0 / step)) ?? 0
              if buys.has(r) || buys.len < 256 {
                buys.set(r, (buys.get(r) ?? 0.0) + c.buy)
                sells.set(r, (sells.get(r) ?? 0.0) + c.sell)
              }
            }
          }
        }
      }
    }
  }
  for k in 0..hourlyMax {
    let t = vh.time(barsAgo: k)
    if t != null {
      let ts = float(time.unixSeconds(t) ?? 0)
      if ts >= fromT && ts >= dailyCut {
        let b = vh.bucketsByStep(step, barsAgo: k)
        if b != null {
          for i in 0..b.len {
            let c = b.get(i)
            if c != null && c.total > 0.0 {
              let r = int(math.floor((c.from + c.to) / 2.0 / step)) ?? 0
              if buys.has(r) || buys.len < 256 {
                buys.set(r, (buys.get(r) ?? 0.0) + c.buy)
                sells.set(r, (sells.get(r) ?? 0.0) + c.sell)
              }
            }
          }
        }
      }
    }
  }
  drawnFor = newest
  rLo.clear()
  rHi.clear()
  rBuy.clear()
  rSell.clear()
  let firstRow = int(math.floor(bottom / step)) ?? 0
  let biggest = 0.0
  let total = 0.0
  for i in 0..200 {
    let r = firstRow + i
    let lowEdge = float(r) * step
    if lowEdge <= top {
      let buy = buys.get(r) ?? 0.0
      let sell = sells.get(r) ?? 0.0
      rLo.push(lowEdge)
      rHi.push(lowEdge + step)
      rBuy.push(buy)
      rSell.push(sell)
      biggest = math.max(biggest, buy + sell)
      total += buy + sell
    }
  }
  computeArea()
  let n = rLo.len
  hist.clear("r")
  if n > 0 && biggest > 0.0 {
    for i in 0..n {
      let lo = rLo[i] ?? 0.0
      let hi = rHi[i] ?? 0.0
      let buy = rBuy[i] ?? 0.0
      let sell = rSell[i] ?? 0.0
      let inArea = hi >= val && lo <= vah
      let hasPoc = lo <= poc && poc < hi
      let alpha = inArea ? 110 : 55
      let lenBuy = widthPx * buy / biggest
      let lenSell = widthPx * sell / biggest
      let gapY = (hi - lo) * 0.06
      if lenBuy > 0.0 {
        hist.get("r", i, "b").set(0.0, hi - gapY, lenBuy, lo + gapY, color: color.withAlpha(buyColor, alpha), borderWidth: hasPoc ? 1.0 : 0.0, borderColor: hasPoc ? color.rgb(240, 240, 240) : null, zIndex: 1)
      }
      if lenSell > 0.0 {
        hist.get("r", i, "s").set(lenBuy, hi - gapY, lenBuy + lenSell, lo + gapY, color: color.withAlpha(sellColor, alpha), borderWidth: hasPoc ? 1.0 : 0.0, borderColor: hasPoc ? color.rgb(240, 240, 240) : null, zIndex: 1)
      }
    }
    // the lookback, and a dotted line at its start
    let fromTime = time.fromUnixSeconds(int(fromT) ?? 0)
    let spanDays = (now - fromT) / 86400.0
    let what = dynamic ? str.format("Dynamic: since swing {0} on {1}", priceText(fromP), time.format(fromTime, "{DD}/{MM}")) : str.format("Lookback from {0}", time.format(fromTime, "{DD}/{MM}"))
    span.get("h").set(6.0, 12.0, str.format("{0} ({1:.0} days)", what, spanDays), color: color.rgb(200, 205, 215), size: 12, textAlign: labelAlign, zIndex: 5)
    fromLine.get("a").set(fromTime, bottom, fromTime, top, width: 1.0, color: color.rgb(200, 205, 215, 110), style: linestyle.dotted)
    let price = chart.forming.close ?? chart.close ?? poc
    findGaps(total / float(n) * gapPct / 100.0, price * gapMinPct / 100.0)
    drawGaps(price, at)
  }
}

on clock.close {
  refresh()
}

on chart.update {
  if chart.isLast {
    liveBar = chart.forming.time ?? chart.time
    refresh()
    let price = chart.forming.close ?? chart.close
    let at = liveBar
    if price != null && at != null && drawnFor >= 0.0 {
      // redraw the nearest gaps when price has moved past one
      if firstAbove(price) != drawnAbove { drawGaps(price, at) }
      let above = firstAbove(price)
      let inside = insideGap(price)
      let below = (inside >= 0 ? inside : above) - 1
      xPoc.plot(poc > 0.0 ? poc : null)
      xVah.plot(vah > 0.0 ? vah : null)
      xVal.plot(val > 0.0 ? val : null)
      xAboveLo.plot(above < gLo.len ? gLo[above] : null)
      xAboveHi.plot(above < gLo.len ? gHi[above] : null)
      xBelowLo.plot(below >= 0 ? gLo[below] : null)
      xBelowHi.plot(below >= 0 ? gHi[below] : null)
      xInsideLo.plot(inside >= 0 ? gLo[inside] : null)
      xInsideHi.plot(inside >= 0 ? gHi[inside] : null)
      xFromDays.plot((float(time.unixSeconds(at) ?? 0) - fromT) / 86400.0)
      xFromPrice.plot(fromP > 0.0 ? fromP : null)
    }
  }
}
