script "Swordfish Offside"

// Where traders are caught offside (Stable workshop 11): a level that matters breaks, price reclaims it, and the
// reclaim holds, judged on 5m bars whatever the chart timeframe. Levels: confirmed 4h swing highs and lows (a swing low
// can only fail as a breakdown, a swing high as a breakout); optional weekly to yearly VWAP levels from the chart
// venue's 4h candles (UTC Monday weeks), which can fail either way.
// Measured from MMT's 5m volume profiles (buy and sell volume per price for each 5m bar, combined across the chosen
// perps by MMT, cut exactly at the level): aggressive selling below a broken support during the break, or buying above
// a broken resistance ("pressed"), its volume-weighted average price, and the opposite aggression back on the reclaimed
// side from the reclaim through the hold ("reclaim x" = back / pressed; workshop 11's reclaim-on-volume). No individual
// trades are loaded.
// Estimated from 5m candles and open interest: +S = (dOI - delta) / 2 and +L = (dOI + delta) / 2 are signed flow
// proxies, not identified positions. Break flow sums the positive proxy over the break, including the reclaim bar;
// counterflow sums its opposite sign after the hold. Neither estimate ends price tracking. Measured net
// flow since the hold is shown beside it. Flow readings use only venues that list the coin, and a bar with a missing
// or misaligned candle or OI reading is skipped, not guessed.
// Wick markers (off by default), delta divergence and reaction zones are separate contextual overlays.
input (
  input.section(title: "Traps")
  showTraps = input.bool(true, title: "Trap markers (failed breakdowns and breakouts)")
  holdMin = input.int(15, title: "Hold (minutes)", min: 5, max: 60, description: "5m closes that must stay on the reclaimed side, without taking the flush extreme. 15 = three 5m closes, as in workshop 11.")
  reclaimMin = input.int(60, title: "Reclaim within (minutes)", min: 5, max: 240, sameLine: true)
  pokePct = input.float(0.03, title: "Break by at least (% of price)", min: 0.0, max: 1.0)
  useSwing = input.bool(true, title: "Levels: 4h swing highs and lows")
  useVwapW = input.bool(false, title: "Levels: weekly VWAP and +/-1 SD", description: "Prior and developing; untested as trap levels, see the guide.")
  useVwapM = input.bool(false, title: "monthly", sameLine: true)
  useVwapQ = input.bool(false, title: "quarterly (and older quarters)", sameLine: true)
  useVwapY = input.bool(false, title: "yearly", sameLine: true)
  showFuel = input.bool(true, title: "Show flow proxies and the pressers' average fill")
  trackHours = input.int(24, title: "Stop tracking after hours", min: 1, max: 168, sameLine: true)
  input.section(title: "Old wick markers")
  showWick = input.bool(false, title: "Trapped-wick markers (the earlier method)")
  wickMin = input.float(0.35, title: "Wick at least this share of the bar's range", min: 0.05, max: 0.95)
  trapMult = input.float(3.0, title: "Wick net delta at least x the typical largest row", min: 0.1)
  input.section(title: "Delta divergence")
  showDiv = input.bool(true, title: "Divergence lines")
  divHours = input.float(10.0, title: "New high or low of the last hours", min: 1.0, max: 200.0, description: "20 bars on 30m, 120 on 5m.")
  input.section(title: "Reaction zones")
  showZones = input.bool(true, title: "Reaction zones")
  zoneMult = input.float(2.5, title: "Row delta at least x the typical largest row", min: 0.5)
  maxZones = input.int(30, title: "Zones kept", min: 1, max: 100)
  input.section(title: "Flow-weighted price proxies")
  showEntries = input.bool(true, title: "+L / +S flow-weighted prices (not entries)")
  halfLifeHours = input.float(48.0, title: "Half-life in hours", min: 1.0, max: 2000.0, description: "Proxy weights from this many hours ago count half; these are not position inventories.")
  input.section(title: "Data")
  rowSize = input.float(0.0, title: "Row size in price (0 = auto, as the delta ladder)", min: 0.0, description: "Auto: the average range of the last 100 bars divided by 10 (the delta ladder's default rows per bar), on a 1/2/2.5/5 grid, never below the tick size; changes only when that range doubles or halves.")
  venue = input.select("Perps: Binance, Bybit, OKX", title: "Volume, OI and liquidations from", options: ["Chart venue", "Binance + Bybit perps", "Perps: Binance, Bybit, OKX"])
  memory = input.int(200, title: "Typical row: bars remembered", min: 20, max: 2000)
  input.section(title: "Look")
  buyColor = input.color(color.rgb(92, 156, 255), title: "Buying / trapped shorts")
  sellColor = input.color(color.rgb(255, 92, 102), title: "Selling / trapped longs", sameLine: true)
  longColor = input.color(color.rgb(34, 171, 126), title: "+L flow-weighted price")
  shortColor = input.color(color.rgb(214, 72, 92), title: "+S flow-weighted price", sameLine: true)
  textSize = input.float(16.0, title: "Label size", min: 8.0, max: 28.0)
)

setup (
  coin = str.startsWith(context.symbol, "btc") ? "BTC" : str.startsWith(context.symbol, "eth") ? "ETH" : str.startsWith(context.symbol, "sol") ? "SOL" : "coins"
  useChart = venue == "Chart venue"
  useAll = venue == "Perps: Binance, Bybit, OKX"
  source = venue == "Binance + Bybit perps" ? markets.agg("binancef", "bybitf") : venue == "Chart venue" ? context.exchange : markets.agg("binancef", "bybitf", "okxf")
  tfSec = float(time.tfSeconds(context.timeframe))
  tfScale = math.sqrt(tfSec / 1800.0) ?? 1.0
  divLook = math.min(2000, math.max(4, int(math.floor(divHours * 3600.0 / tfSec)) ?? 20))
  halfLife = math.max(1.0, halfLifeHours * 3600.0 / tfSec)
  holdBars = math.max(1, int(math.floor(float(holdMin) / 5.0)) ?? 3)
  reclaimBars = math.max(1, int(math.floor(float(reclaimMin) / 5.0)) ?? 12)
  anyVwap = useVwapW || useVwapM || useVwapQ || useVwapY
  usePair = venue == "Binance + Bybit perps"
)

data (
  chart = subscribe(data.ohlcv)
  vol = subscribe(data.volume, exchange: source)
  // each venue's candles, summed for buy and sell volume (MMT has no combined candles)
  bnC = subscribe(data.ohlcv, exchange: "binancef")
  bbC = subscribe(data.ohlcv, exchange: "bybitf")
  okC = subscribe(data.ohlcv, exchange: "okxf")
  oiAgg = subscribe(data.oi, exchange: source)
  // traps run on 5m bars: price from the chart's market, flow from the chosen venues
  p5 = subscribe(data.ohlcv, timeframe: 5m, history: 1500)
  bn5 = subscribe(data.ohlcv, exchange: "binancef", timeframe: 5m, history: 1500)
  bb5 = subscribe(data.ohlcv, exchange: "bybitf", timeframe: 5m, history: 1500)
  ok5 = subscribe(data.ohlcv, exchange: "okxf", timeframe: 5m, history: 1500)
  oi5 = subscribe(data.oi, exchange: source, timeframe: 5m, history: 1500)
  liq5 = subscribe(data.stat, exchange: source, timeframe: 5m, history: 1500)
  // the chart timeframe's liquidations, for the agent export only
  liqC = subscribe(data.stat, exchange: source)
  // 5m volume profiles (buy and sell per price, combined by MMT) for the break measurements
  v5 = subscribe(data.volume, exchange: source, timeframe: 5m, history: 1500)
  // levels: 4h swings and, when any VWAP level is on, the VWAPs (a year and a half of 4h candles)
  h4 = subscribe(data.ohlcv, timeframe: 4h, history: anyVwap ? 3300 : 300)
)

window traps = window(title: "Recent traps") {
  list: table.new([
    table.col(title: "Confirmed (UTC)", width: 1.1),
    table.col(title: "Trapped", width: 0.7),
    table.col(title: "Level", width: 1.6),
    table.col(title: "Pressed", align: align.right),
    table.col(title: "Avg fill", align: align.right),
    table.col(title: "Reclaim x", align: align.right),
    table.col(title: "Stopped out", align: align.right),
    table.col(title: "Stop", align: align.right),
    table.col(title: "Break flow proxy", align: align.right),
    table.col(title: "Counterflow proxy", align: align.right),
    table.col(title: "Net flow since", align: align.right),
    table.col(title: "Status", width: 1.3),
  ], title: "Traps", capacity: 60),
  // Agent export: the newest trap per side, the level being traded through, the nearest watched levels and live
  // reaction zones, and the latest delta divergences, as hidden series for script_get_plot_values (live bar
  // included). Times are minutes since 2026-01-01 00:00 UTC. status: 1 holding, 0 ended, -1 failed. active.state:
  // 1 broken (waiting for a reclaim), 2 reclaimed and holding; dir: -1 broke down, +1 broke up.
  export: chart.panel(chart),
}

plot (
  xLMin = plot.line(title: "x.trap_longs.min", on: traps.export)
  xLLevel = plot.line(title: "x.trap_longs.level", on: traps.export)
  xLStop = plot.line(title: "x.trap_longs.stop", on: traps.export)
  xLAvgFill = plot.line(title: "x.trap_longs.avg_fill", on: traps.export)
  xLPressed = plot.line(title: "x.trap_longs.pressed", on: traps.export)
  xLReclaimX = plot.line(title: "x.trap_longs.reclaim_x", on: traps.export)
  xLStoppedOut = plot.line(title: "x.trap_longs.stopped_out", on: traps.export)
  xLBreakFlow = plot.line(title: "x.trap_longs.break_flow", on: traps.export)
  xLCounterflow = plot.line(title: "x.trap_longs.counterflow", on: traps.export)
  xLNetFlow = plot.line(title: "x.trap_longs.net_flow", on: traps.export)
  xLStatus = plot.line(title: "x.trap_longs.status", on: traps.export)
  xLTradeOk = plot.line(title: "x.trap_longs.trade_ok", on: traps.export)
  xLWick = plot.line(title: "x.trap_longs.wick", on: traps.export)
  xLBreakMin = plot.line(title: "x.trap_longs.break_min", on: traps.export)
  xSMin = plot.line(title: "x.trap_shorts.min", on: traps.export)
  xSLevel = plot.line(title: "x.trap_shorts.level", on: traps.export)
  xSStop = plot.line(title: "x.trap_shorts.stop", on: traps.export)
  xSAvgFill = plot.line(title: "x.trap_shorts.avg_fill", on: traps.export)
  xSPressed = plot.line(title: "x.trap_shorts.pressed", on: traps.export)
  xSReclaimX = plot.line(title: "x.trap_shorts.reclaim_x", on: traps.export)
  xSStoppedOut = plot.line(title: "x.trap_shorts.stopped_out", on: traps.export)
  xSBreakFlow = plot.line(title: "x.trap_shorts.break_flow", on: traps.export)
  xSCounterflow = plot.line(title: "x.trap_shorts.counterflow", on: traps.export)
  xSNetFlow = plot.line(title: "x.trap_shorts.net_flow", on: traps.export)
  xSStatus = plot.line(title: "x.trap_shorts.status", on: traps.export)
  xSTradeOk = plot.line(title: "x.trap_shorts.trade_ok", on: traps.export)
  xSWick = plot.line(title: "x.trap_shorts.wick", on: traps.export)
  xSBreakMin = plot.line(title: "x.trap_shorts.break_min", on: traps.export)
  xActPrice = plot.line(title: "x.active.level", on: traps.export)
  xActDir = plot.line(title: "x.active.dir", on: traps.export)
  xActFlush = plot.line(title: "x.active.flush", on: traps.export)
  xActState = plot.line(title: "x.active.state", on: traps.export)
  xActHeld = plot.line(title: "x.active.held_bars", on: traps.export)
  xActBars = plot.line(title: "x.active.bars_since_break", on: traps.export)
  xActFrom = plot.line(title: "x.active.break_min", on: traps.export)
  xWatchAbove = plot.line(title: "x.watch.above", on: traps.export)
  xWatchBelow = plot.line(title: "x.watch.below", on: traps.export)
  xWatchCount = plot.line(title: "x.watch.count", on: traps.export)
  xZoneAboveLo = plot.line(title: "x.zone_above.lo", on: traps.export)
  xZoneAboveHi = plot.line(title: "x.zone_above.hi", on: traps.export)
  xZoneAboveSign = plot.line(title: "x.zone_above.sign", on: traps.export)
  xZoneBelowLo = plot.line(title: "x.zone_below.lo", on: traps.export)
  xZoneBelowHi = plot.line(title: "x.zone_below.hi", on: traps.export)
  xZoneBelowSign = plot.line(title: "x.zone_below.sign", on: traps.export)
  xDivBearMin = plot.line(title: "x.div_bear.min", on: traps.export)
  xDivBearPrice = plot.line(title: "x.div_bear.price", on: traps.export)
  xDivBullMin = plot.line(title: "x.div_bull.min", on: traps.export)
  xDivBullPrice = plot.line(title: "x.div_bull.price", on: traps.export)
  xBarLongLiq = plot.line(title: "x.bar.long_liq", on: traps.export)
  xBarShortLiq = plot.line(title: "x.bar.short_liq", on: traps.export)
  xBarPlusL = plot.line(title: "x.bar.plus_l_proxy", on: traps.export)
  xBarPlusS = plot.line(title: "x.bar.plus_s_proxy", on: traps.export)
  xBarBuy = plot.line(title: "x.bar.buy_vol", on: traps.export)
  xBarSell = plot.line(title: "x.bar.sell_vol", on: traps.export)
  xBarDelta = plot.line(title: "x.bar.delta", on: traps.export)
  xBarOi = plot.line(title: "x.bar.oi_close", on: traps.export)
  xBarDOi = plot.line(title: "x.bar.oi_change", on: traps.export)
  xHeatBar = plot.line(title: "x.heat.bar_min", on: traps.export)
  xHeatMaxPrice = plot.line(title: "x.heat.max_row_price", on: traps.export)
  xHeatMaxUsd = plot.line(title: "x.heat.max_row_usd", on: traps.export)
  xHeatNetUsd = plot.line(title: "x.heat.net_usd", on: traps.export)
  xHeatUpperWickUsd = plot.line(title: "x.heat.above_body_usd", on: traps.export)
  xHeatLowerWickUsd = plot.line(title: "x.heat.below_body_usd", on: traps.export)
  xHeatTypical = plot.line(title: "x.heat.typical_max_usd", on: traps.export)
)

plot (
  longLine = plot.line(title: "+L flow-weighted price", color: longColor, width: 1.5, style: linestyle.dotted, showLabel: false)
  shortLine = plot.line(title: "+S flow-weighted price", color: shortColor, width: 1.5, style: linestyle.dotted, showLabel: false)
)

state (
  step: float = 0.0
  peaks = rolling<float>(memory)
  ranges = rolling<float>(100)
  // the lookback's highs, lows, cumulative delta and times, oldest first
  highs = rolling<float>(divLook)
  lows = rolling<float>(divLook)
  cvds = rolling<float>(divLook)
  times = rolling<time>(divLook)
  cvd: float = 0.0
  // reaction zones, a ring of slots
  zLo = float[](100)
  zHi = float[](100)
  zSign = float[](100)
  zFrom = time[](100)
  zLive = bool[](100)
  zNext: int = 0
  // Signed flow weights and their HLC3-weighted prices; not open positions.
  lQty: float = 0.0
  lCost: float = 0.0
  sQty: float = 0.0
  sCost: float = 0.0
  lastDone: time? = null
  nTL: int = 0
  nTS: int = 0
  nDiv: int = 0
  nZones: int = 0
  marks = entities.markerPool(max: 500)
  divLines = entities.linePool(max: 200)
  zones = entities.boxPool(max: 100)
  edge = entities.labelPool(max: 2, anchor: anchor.right)
  // the newest trap on each side, as a panel in the price pane's bottom-right corner
  hud = entities.labelPool(max: 2, anchor: anchor.bottomRight)
  // levels watched for traps: price, side (+1 support, -1 resistance, 0 either), name, expiry (unix s), state
  // (0 watching, 1 broken, 2 holding, 3 done), direction of the break, flush extreme, bars since the break, hold
  // count, new positions, stopped-out liquidations, price x volume and volume of the break bars, break start
  lvP = float[](120)
  lvSide = float[](120)
  lvName = string[](120)
  lvExp = float[](120)
  lvState = int[](120)
  lvDir = float[](120)
  lvFlush = float[](120)
  lvBars = int[](120)
  lvHeld = int[](120)
  lvNew = float[](120)
  lvStop = float[](120)
  lvPv = float[](120)
  lvV = float[](120)
  lvFrom = time[](120)
  lvFlowOk = bool[](120)
  // volume credited to a broken level: pressed beyond it, price x volume, opposite aggression back on the reclaimed
  // side, and whether every bar of the break had its volume profile
  lvPressed = float[](120)
  lvPressedPv = float[](120)
  lvBack = float[](120)
  lvTradeOk = bool[](120)
  prevC5: float = 0.0
  // the last 5m bar processed (unix s), to detect a missing bar, and the last closed chart bar
  prevT5: float = 0.0
  prevChartT: float = 0.0
  lastTrap = map<int, float>(2)
  recentNew = rolling<float>(20)
  // 4h swing detection: the last 7 bars
  sw4H = rolling<float>(7)
  sw4L = rolling<float>(7)
  // Calendar VWAP accumulators per unit (0 week, 1 month, 2 quarter, 3 year): volume, price x volume,
  // price^2 x volume, period key, first bar (unix s), whether the period was seen from its start
  accW = float[](4)
  accPw = float[](4)
  accP2w = float[](4)
  accKey = float[](4)
  accStart = float[](4)
  accFull = bool[](4)
  // traps being tracked, a ring of slots: side (-1 longs, +1 shorts), confirmed, size in coins, unwound, flush
  // extreme (stop), pain point, level price, level name, stopped-out coins, dollars, status, still tracked, kind
  fSide = float[](40)
  fTime = time[](40)
  fQty = float[](40)
  fDone = float[](40)
  fExt = float[](40)
  fPain = float[](40)
  fLvl = float[](40)
  fName = string[](40)
  fStopped = float[](40)
  fUsd = float[](40)
  fStatus = string[](40)
  fLive = bool[](40)
  fWick = bool[](40)
  fFrom = time[](40)
  fFlowOk = bool[](40)
  fCounterOk = bool[](40)
  fPressed = float[](40)
  fFill = float[](40)
  fBack = float[](40)
  fTradeOk = bool[](40)
  fNet = float[](40)
  // venues that list this coin (checked once)
  listedSet: bool = false
  lsBn: bool = false
  lsBb: bool = false
  lsOk: bool = false
  // one profile read: volume, price x volume, and whether the bar's profile was there
  profVol: float = 0.0
  profPv: float = 0.0
  recentPressed = rolling<float>(20)
  fNext: int = 0
  divBearT: float = 0.0
  divBearP: float = 0.0
  divBullT: float = 0.0
  divBullP: float = 0.0
  painLines = entities.linePool(max: 40)
  levelLines = entities.linePool(max: 40)
)

// 1, 2, 2.5 or 5 times a power of ten, nearest above the target (as the delta ladder).
fn niceStep(target: float) -> float {
  let magnitude = math.pow(10.0, math.floor(math.log10(target) ?? 0.0)) ?? 1.0
  let n = target / magnitude
  return magnitude * (n <= 1.0 ? 1.0 : n <= 2.0 ? 2.0 : n <= 2.5 ? 2.5 : n <= 5.0 ? 5.0 : 10.0)
}

// Venues that list this coin; a venue without the listing is left out of flow checks and sums.
fn ensureListed() {
  if !listedSet {
    lsBn = markets.tickSize("binancef", context.symbol) != null
    lsBb = markets.tickSize("bybitf", context.symbol) != null
    lsOk = markets.tickSize("okxf", context.symbol) != null
    listedSet = true
  }
}

fn candleOk(t: time, ct: time?, bv: float?, sv: float?) -> bool {
  return ct == t && math.isFinite(bv) && math.isFinite(sv)
}

// Every listed selected venue has this bar's candle, at least one does.
fn flowReady5(t: time) -> bool {
  if useChart { return candleOk(t, p5.time, p5.buyVolume, p5.sellVolume) }
  let any = lsBn || lsBb || (useAll && lsOk)
  return any && (!lsBn || candleOk(t, bn5.time, bn5.buyVolume, bn5.sellVolume)) && (!lsBb || candleOk(t, bb5.time, bb5.buyVolume, bb5.sellVolume)) &&
    (!useAll || !lsOk || candleOk(t, ok5.time, ok5.buyVolume, ok5.sellVolume))
}

fn flowReadyClosed(t: time) -> bool {
  if useChart { return candleOk(t, chart.time, chart.buyVolume, chart.sellVolume) }
  let any = lsBn || lsBb || (useAll && lsOk)
  return any && (!lsBn || candleOk(t, bnC.time, bnC.buyVolume, bnC.sellVolume)) && (!lsBb || candleOk(t, bbC.time, bbC.buyVolume, bbC.sellVolume)) &&
    (!useAll || !lsOk || candleOk(t, okC.time, okC.buyVolume, okC.sellVolume))
}

fn flowReadyLive(t: time) -> bool {
  if useChart { return candleOk(t, chart.forming.time, chart.forming.buyVolume, chart.forming.sellVolume) }
  let any = lsBn || lsBb || (useAll && lsOk)
  return any && (!lsBn || candleOk(t, bnC.forming.time, bnC.forming.buyVolume, bnC.forming.sellVolume)) && (!lsBb || candleOk(t, bbC.forming.time, bbC.forming.buyVolume, bbC.forming.sellVolume)) &&
    (!useAll || !lsOk || candleOk(t, okC.forming.time, okC.forming.buyVolume, okC.forming.sellVolume))
}

// The forming bar's volume and open interest are all on the bar at t (Bar Stats and the agent export use this).
fn liveFlowReady(t: time) -> bool {
  return flowReadyLive(t) && oiAgg.forming.time == t && math.isFinite(oiAgg.forming.open) && math.isFinite(oiAgg.forming.close)
}

// Fold one closed chart bar into the +L/+S flow-weighted prices: weights fade by `keep`, positive proxy flow adds weight
// at the bar's HLC3, negative flow removes weight in proportion. A bar that is not ready (a missing bar, or a selected
// venue's candle or the open interest not on it) resets all four accumulators: the flow in a gap is unknown, so weights
// from before it are not carried into later prices. The prices are unavailable until valid bars rebuild them.
fn flowStep(ready: bool, nl: float, ns: float, p: float, keep: float) {
  if !ready {
    lQty = 0.0
    lCost = 0.0
    sQty = 0.0
    sCost = 0.0
    return
  }
  lQty = lQty * keep
  lCost = lCost * keep
  sQty = sQty * keep
  sCost = sCost * keep
  if nl > 0.0 {
    lQty += nl
    lCost += nl * p
  } else if lQty > 0.0 {
    let f = math.max(0.0, 1.0 + nl / lQty)
    lQty = lQty * f
    lCost = lCost * f
  }
  if ns > 0.0 {
    sQty += ns
    sCost += ns * p
  } else if sQty > 0.0 {
    let f = math.max(0.0, 1.0 + ns / sQty)
    sQty = sQty * f
    sCost = sCost * f
  }
}

// A price with decimals for its size: 80,345 / 2,460.5 / 184.23 / 0.19345.
fn priceText(v: float) -> string {
  let a = math.abs(v)
  if a >= 10000.0 { return str.format("{0:,.0}", v) }
  if a >= 1000.0 { return str.format("{0:,.1}", v) }
  if a >= 100.0 { return str.format("{0:.2}", v) }
  if a >= 10.0 { return str.format("{0:.3}", v) }
  if a >= 1.0 { return str.format("{0:.4}", v) }
  return str.format("{0:.5}", v)
}

// Dollars as $850K or $2.1M.
fn money(v: float) -> string {
  let a = math.abs(v)
  if a >= 1000000.0 { return str.concat("$", str.format("{0:.1}M", a / 1000000.0)) }
  if a >= 1000.0 { return str.concat("$", str.format("{0:.0}K", a / 1000.0)) }
  return str.concat("$", str.format("{0:.0}", a))
}

fn unix(t: time) -> float {
  return float(time.unixSeconds(t) ?? 0)
}

// One reaction zone into the next ring slot.
fn addZone(lo: float, hi: float, sign: float, at: time) {
  let k = zNext
  if zLo.len < maxZones {
    zLo.push(lo)
    zHi.push(hi)
    zSign.push(sign)
    zFrom.push(at)
    zLive.push(true)
  } else {
    zLo[k] = lo
    zHi[k] = hi
    zSign[k] = sign
    zFrom[k] = at
    zLive[k] = true
  }
  zNext = k + 1 >= maxZones ? 0 : k + 1
  nZones += 1
  let tint = sign > 0.0 ? buyColor : sellColor
  zones.get(k).set(at, lo, at, hi, color: color.withAlpha(tint, 70), borderWidth: 1.0, borderColor: color.withAlpha(tint, 170), extend: extend.right)
}

// A level to watch; skipped when the same name already watches nearly the same price.
fn addLevel(price: float, side: float, name: string, expires: float) {
  let free = -1
  for k in 0..lvP.len {
    let st = lvState[k] ?? 3
    if st != 3 && (lvName[k] ?? "") == name && math.abs((lvP[k] ?? 0.0) / price - 1.0) < 0.0002 {
      return
    }
    if free < 0 && st == 3 { free = k }
  }
  if free < 0 && lvP.len < 120 {
    lvP.push(price)
    lvSide.push(side)
    lvName.push(name)
    lvExp.push(expires)
    lvState.push(0)
    lvDir.push(0.0)
    lvFlush.push(0.0)
    lvBars.push(0)
    lvHeld.push(0)
    lvNew.push(0.0)
    lvStop.push(0.0)
    lvPv.push(0.0)
    lvV.push(0.0)
    lvFrom.push(time.fromUnixSeconds(0))
    lvFlowOk.push(false)
    lvPressed.push(0.0)
    lvPressedPv.push(0.0)
    lvBack.push(0.0)
    lvTradeOk.push(false)
    return
  }
  if free < 0 { return }
  lvP[free] = price
  lvSide[free] = side
  lvName[free] = name
  lvExp[free] = expires
  lvState[free] = 0
}

// A trap's lines and its row in the Recent traps window.
fn drawTrap(k: int, now: time) {
  let side = fSide[k] ?? 0.0
  let at = fTime[k] ?? now
  let live = fLive[k] ?? false
  let tint = side < 0.0 ? sellColor : buyColor
  let pain = fPain[k] ?? 0.0
  let tradeOk = fTradeOk[k] ?? false
  let wick = fWick[k] ?? false
  // short captions on the lines: what the line is, and how the trap stands
  let st = fStatus[k] ?? ""
  let brief = live ? "holding" : str.startsWith(st, "failed") ? "failed" : "ended"
  if showFuel {
    let cap = wick ? "wick break-even" : tradeOk ? (side > 0.0 ? "sellers' avg fill below level" : "buyers' avg fill above level") : "break VWAP"
    painLines.get(k).set(at, pain, now, pain, width: 1.5, color: color.withAlpha(tint, live ? 220 : 90), style: linestyle.dotted, text: cap)
  }
  // the level that failed, from the break to now while the trap holds, then fixed where it ended
  if !wick {
    let lvl = fLvl[k] ?? 0.0
    levelLines.get(k).set(fFrom[k] ?? at, lvl, now, lvl, width: 1.0, color: color.withAlpha(tint, live ? 200 : 80), text: str.concat(fName[k] ?? "", side > 0.0 ? " | failed breakdown | " : " | failed breakout | ", brief))
  }
  let pressed = fPressed[k] ?? 0.0
  let flowOk = fFlowOk[k] ?? false
  traps.list.row(str.format("slot{0}", k),
    time.format(at, "{MM}-{DD} {HH}:{mm}"),
    table.cell(side < 0.0 ? "Longs" : "Shorts", fg: tint),
    fName[k] ?? "",
    tradeOk ? str.format("{0:,.0} {1}", pressed, coin) : "-",
    tradeOk ? priceText(fFill[k] ?? 0.0) : "-",
    tradeOk && pressed > 0.0 ? str.format("{0:.1}x", (fBack[k] ?? 0.0) / pressed) : "-",
    wick || (fStopped[k] ?? 0.0) < 0.0 ? "-" : str.format("{0:,.0} {1}", fStopped[k] ?? 0.0, coin),
    priceText(fExt[k] ?? 0.0),
    flowOk ? str.format("{0:,.0} {1}", fQty[k] ?? 0.0, coin) : "-",
    (fCounterOk[k] ?? false) && flowOk ? str.format("{0:,.0} {1}", fDone[k] ?? 0.0, coin) : "-",
    (fCounterOk[k] ?? false) ? str.format("{0:+,.0} {1}", fNet[k] ?? 0.0, coin) : "-",
    fStatus[k] ?? "")
}

// One line of the corner panel.
fn trapLine(k: int, name: string) -> string {
  let at = fTime[k]
  let side = fSide[k] ?? 0.0
  let wick = fWick[k] ?? false
  let tradeOk = fTradeOk[k] ?? false
  let pressed = fPressed[k] ?? 0.0
  let measured = wick ? str.format("{0:,.0} {1} in the wick", fQty[k] ?? 0.0, coin) :
    tradeOk ? str.format("pressed {0:,.0} {1} {2} at avg {3} | reclaim {4:.1}x", pressed, coin, side > 0.0 ? "below" : "above", priceText(fFill[k] ?? 0.0), pressed > 0.0 ? (fBack[k] ?? 0.0) / pressed : 0.0) :
    str.concat("no volume profile | break VWAP ", priceText(fFill[k] ?? 0.0))
  let stopped = wick ? "" : (fStopped[k] ?? 0.0) < 0.0 ? " | liquidations n/a" : str.format(" | {0:,.0} {1} liq", fStopped[k] ?? 0.0, side > 0.0 ? "longs" : "shorts")
  let est = (fCounterOk[k] ?? false) ? str.format(" | counterflow proxy {0:,.0} {1}", fDone[k] ?? 0.0, coin) : " | counterflow unavailable"
  return str.concat(name, " ", at != null ? time.format(at, "{MM}-{DD} {HH}:{mm} UTC") : "", " | ", fName[k] ?? "", " | ", measured, stopped,
    " | stop ", priceText(fExt[k] ?? 0.0), showFuel ? est : "", " | ", fStatus[k] ?? "")
}

// A new trap into the next ring slot, with its marker. qty is the positive break-flow proxy; pressed, fill and back
// come from the 5m volume profiles when tradeOk.
fn addTrap(side: float, at: time, from: time, qty: float, ext: float, pain: float, lvl: float, name: string, stopped: float, wick: bool, flowOk: bool, pressed: float, avgFill: float, back: float, tradeOk: bool) {
  let k = fNext
  let line = tradeOk ? avgFill : pain
  if fSide.len < 40 {
    fSide.push(side)
    fTime.push(at)
    fQty.push(qty)
    fDone.push(0.0)
    fExt.push(ext)
    fPain.push(line)
    fLvl.push(lvl)
    fName.push(name)
    fStopped.push(stopped)
    fUsd.push(qty * pain)
    fStatus.push("holding")
    fLive.push(true)
    fWick.push(wick)
    fFrom.push(from)
    fFlowOk.push(flowOk)
    fCounterOk.push(flowOk)
    fPressed.push(pressed)
    fFill.push(tradeOk ? avgFill : pain)
    fBack.push(back)
    fTradeOk.push(tradeOk)
    fNet.push(0.0)
  } else {
    fSide[k] = side
    fTime[k] = at
    fQty[k] = qty
    fDone[k] = 0.0
    fExt[k] = ext
    fPain[k] = line
    fLvl[k] = lvl
    fName[k] = name
    fStopped[k] = stopped
    fUsd[k] = qty * pain
    fStatus[k] = "holding"
    fLive[k] = true
    fWick[k] = wick
    fFrom[k] = from
    fFlowOk[k] = flowOk
    fCounterOk[k] = flowOk
    fPressed[k] = pressed
    fFill[k] = tradeOk ? avgFill : pain
    fBack[k] = back
    fTradeOk[k] = tradeOk
    fNet[k] = 0.0
  }
  fNext = k + 1 >= 40 ? 0 : k + 1
  if side < 0.0 { nTL += 1 } else { nTS += 1 }
  // The marker sits beyond the flush extreme; bigger when more was pressed (volume profile) than the recent traps'
  // average, or, without a profile, when the positive break-flow proxy was above average.
  let many = tradeOk ? pressed > (recentPressed.avg() ?? pressed) : flowOk && qty > (recentNew.avg() ?? qty)
  if tradeOk { recentPressed.push(pressed) }
  if flowOk { recentNew.push(qty) }
  let bar = time.floor(at, context.timeframe)
  let gap = (step > 0.0 ? step : ext * 0.0006) * 3.0
  marks.get(side < 0.0 ? "L" : "S", at).set(bar, side < 0.0 ? ext + gap : ext - gap, shape: side < 0.0 ? shape.down : shape.up, color: color.withAlpha(side < 0.0 ? sellColor : buyColor, many ? 255 : 170), size: many ? 11.0 : 7.0)
  drawTrap(k, at)
}

// Calendar VWAP: one candle into a unit's accumulators; a new period first turns the finished one into levels.
fn unitName(u: int) -> string {
  return u == 0 ? "week" : u == 1 ? "month" : u == 2 ? "quarter" : "year"
}

fn unitOn(u: int) -> bool {
  return u == 0 ? useVwapW : u == 1 ? useVwapM : u == 2 ? useVwapQ : useVwapY
}

fn periodKey(u: int, t: time) -> float {
  let y = time.year(t)
  let m = time.month(t)
  if u == 0 { return unix(time.floor(t, 1W)) }
  if u == 1 { return float(y * 12 + m - 1) }
  if u == 2 { return float(y * 4) + math.floor(float(m - 1) / 3.0) }
  return float(y)
}

fn addVwapLevels(u: int, prefix: string, w: float, pw: float, p2w: float, expires: float) {
  if w <= 0.0 { return }
  let m = pw / w
  let sd = math.sqrt(math.max(p2w / w - m * m, 0.0)) ?? 0.0
  let base = str.concat(prefix, " ", unitName(u))
  addLevel(m, 0.0, str.concat(base, " VWAP"), expires)
  addLevel(m + sd, 0.0, str.concat(base, " +1SD"), expires)
  addLevel(m - sd, 0.0, str.concat(base, " -1SD"), expires)
}

fn addCandle(u: int, t: time, h: float?, l: float?, c: float?, v: float?) {
  if h == null || l == null || c == null || v == null { return }
  if accW.len == 0 {
    for i in 0..4 {
      accW.push(0.0)
      accPw.push(0.0)
      accP2w.push(0.0)
      accKey.push(-1.0)
      accStart.push(0.0)
      accFull.push(false)
    }
  }
  let key = periodKey(u, t)
  let now = unix(t)
  if key != (accKey[u] ?? -1.0) {
    let seen = (accKey[u] ?? -1.0) >= 0.0
    if seen && (accFull[u] ?? false) && unitOn(u) {
      let life = u == 0 ? 604800.0 : u == 1 ? 2678400.0 : 31622400.0
      addVwapLevels(u, "prior", accW[u] ?? 0.0, accPw[u] ?? 0.0, accP2w[u] ?? 0.0, now + life)
    }
    accW[u] = 0.0
    accPw[u] = 0.0
    accP2w[u] = 0.0
    accKey[u] = key
    accStart[u] = now
    accFull[u] = seen
  }
  let p = (h + l + c) / 3.0
  accW[u] = (accW[u] ?? 0.0) + v
  accPw[u] = (accPw[u] ?? 0.0) + p * v
  accP2w[u] = (accP2w[u] ?? 0.0) + p * p * v
}

// Developing levels, taken at a UTC day start once a day of the period has traded.
fn developing(u: int, t: time) {
  if !unitOn(u) || accW.len == 0 { return }
  let now = unix(t)
  if now - (accStart[u] ?? now) >= 86400.0 {
    addVwapLevels(u, "developing", accW[u] ?? 0.0, accPw[u] ?? 0.0, accP2w[u] ?? 0.0, now + 86400.0)
  }
}

// 4h swing highs and lows: the middle of the last 7 bars, below (above) the 3 before and not above (below) the 3 after.
on h4.close {
  let hh = h4.high
  let ll = h4.low
  let t = h4.time
  if t != null && anyVwap {
    if math.floor(unix(t) / 86400.0) * 86400.0 == unix(t) {
      for u in 0..4 { developing(u, t) }
    }
    for u in 0..4 { addCandle(u, t, h4.high, h4.low, h4.close, h4.volume) }
  }
  if hh != null && ll != null && t != null {
    sw4H.push(hh)
    sw4L.push(ll)
    if useSwing && sw4H.isFull {
      let midL = sw4L[3] ?? 0.0
      let midH = sw4H[3] ?? 0.0
      let lowBefore = math.min(sw4L[0] ?? 0.0, math.min(sw4L[1] ?? 0.0, sw4L[2] ?? 0.0))
      let lowAfter = math.min(sw4L[4] ?? 0.0, math.min(sw4L[5] ?? 0.0, sw4L[6] ?? 0.0))
      let highBefore = math.max(sw4H[0] ?? 0.0, math.max(sw4H[1] ?? 0.0, sw4H[2] ?? 0.0))
      let highAfter = math.max(sw4H[4] ?? 0.0, math.max(sw4H[5] ?? 0.0, sw4H[6] ?? 0.0))
      let expires = unix(t) + 14400.0 + 14.0 * 86400.0
      if midL < lowBefore && midL <= lowAfter { addLevel(midL, 1.0, "4h swing low", expires) }
      if midH > highBefore && midH >= highAfter { addLevel(midH, -1.0, "4h swing high", expires) }
    }
  }
}

// Volume in one 5m bar's profile between two prices (both included), on MMT's native price bins: sells, or buys, and
// their price x volume (each bin at its midpoint), into profVol / profPv. False when the bar has no profile.
fn readProfile(t: time, lo: float, hi: float, buys: bool) -> bool {
  profVol = 0.0
  profPv = 0.0
  if v5.time() != t { return false }
  let bin = v5.binSize() ?? 0.0
  if !(bin > 0.0) { return false }
  if hi < lo { return true }
  let b = v5.bucketsByStep(math.max(bin, (hi - lo) / 4000.0), from: lo, to: hi)
  if b == null { return true }
  for i in 0..b.len {
    let c = b.get(i)
    if c != null {
      let v = buys ? c.buy : c.sell
      profVol += v
      profPv += v * (c.from + c.to) / 2.0
    }
  }
  return true
}

// One 5m bar credited to a broken level at L: pressed (sells below a support, buys above a resistance) on broken bars
// through the reclaim close, and back (the opposite aggression on the reclaimed side) from the successful reclaim
// through the hold. The profile is cut just inside the level, so volume at the level's own price counts on neither
// side. A bar without its profile marks the level's readings unavailable.
fn creditBar(k: int, dir: float, t: time, L: float, lo: float, hi: float, withPressed: bool, withBack: bool) {
  let edge = L * 0.0000001
  let ok = true
  if withPressed {
    ok = dir > 0.0 ? readProfile(t, lo, L - edge, false) : readProfile(t, L + edge, hi, true)
    lvPressed[k] = (lvPressed[k] ?? 0.0) + profVol
    lvPressedPv[k] = (lvPressedPv[k] ?? 0.0) + profPv
  }
  if withBack && ok {
    ok = dir > 0.0 ? readProfile(t, L + edge, hi, true) : readProfile(t, lo, L - edge, false)
    lvBack[k] = (lvBack[k] ?? 0.0) + profVol
  }
  if !withPressed && !withBack { ok = v5.time() == t }
  lvTradeOk[k] = (lvTradeOk[k] ?? false) && ok
}

// Traps and counterflow, every 5m bar.
on p5.close {
  let t = p5.time
  let h = p5.high
  let l = p5.low
  let c = p5.close
  if t != null && h != null && l != null && c != null {
    ensureListed()
    if step <= 0.0 { step = rowSize > 0.0 ? rowSize : niceStep(c * 0.0006 * tfScale) }
    let now = unix(t)
    // a missing 5m bar: whatever price did in the gap is unknown, so setups in progress are dropped (the level is
    // watched again), tracked traps end, and no break is read from a close before the gap
    let gap = prevT5 > 0.0 && now - prevT5 > 300.0
    if gap {
      for k in 0..lvP.len {
        let gst = lvState[k] ?? 3
        if gst == 1 || gst == 2 { lvState[k] = 0 }
      }
      for k in 0..fSide.len {
        if fLive[k] ?? false {
          fLive[k] = false
          fStatus[k] = "ended: 5m data gap"
          drawTrap(k, t)
        }
      }
    }
    // Signed flow proxies over the chosen venues.
    let bv = useChart ? (p5.buyVolume ?? 0.0) : (bn5.buyVolume ?? 0.0) + (bb5.buyVolume ?? 0.0) + (useAll ? (ok5.buyVolume ?? 0.0) : 0.0)
    let sv = useChart ? (p5.sellVolume ?? 0.0) : (bn5.sellVolume ?? 0.0) + (bb5.sellVolume ?? 0.0) + (useAll ? (ok5.sellVolume ?? 0.0) : 0.0)
    let d = bv - sv
    let oo = oi5.open
    let oc = oi5.close
    let flowOk = flowReady5(t) && oi5.time == t && oo != null && oc != null
    let dOi = flowOk && oo != null && oc != null ? oc - oo : 0.0
    let nl = (dOi + d) / 2.0
    let ns = (dOi - d) / 2.0
    // liquidations only when the stat is on this bar; otherwise the break's liquidation total becomes unknown (-1)
    let liqOk = liq5.time == t && math.isFinite(liq5.buyLiq) && math.isFinite(liq5.sellLiq)
    let longLiq = liqOk ? liq5.buyLiq ?? 0.0 : 0.0
    let shortLiq = liqOk ? liq5.sellLiq ?? 0.0 : 0.0
    let vv = p5.volume ?? 0.0
    let pp = (h + l + c) / 3.0

    // Counterflow and price status of the traps being tracked.
    for k in 0..fSide.len {
      if fLive[k] ?? false {
        let side = fSide[k] ?? 0.0
        let done = (fDone[k] ?? 0.0) + (side > 0.0 ? math.max(-ns, 0.0) : math.max(-nl, 0.0))
        fCounterOk[k] = (fCounterOk[k] ?? false) && flowOk
        if fCounterOk[k] ?? false {
          fDone[k] = done
          fNet[k] = (fNet[k] ?? 0.0) + (side > 0.0 ? d : -d)
        }
        let lvl = fLvl[k] ?? 0.0
        let ext = fExt[k] ?? 0.0
        let wick = fWick[k] ?? false
        let back = !wick && (side > 0.0 ? c < lvl : c > lvl)
        let flushed = side > 0.0 ? l < ext : h > ext
        let expired = now - unix(fTime[k] ?? t) >= float(trackHours) * 3600.0
        if back || flushed || expired {
          fLive[k] = false
          fStatus[k] = back ? (side > 0.0 ? "failed: closed back below the level" : "failed: closed back above the level") : flushed ? (wick ? (side > 0.0 ? "closed below wick" : "closed above wick") : (side > 0.0 ? "failed: flush low taken" : "failed: flush high taken")) : str.format("tracked {0}h, ended", trackHours)
        }
        drawTrap(k, t)
      }
    }

    // levels: watching, broken, holding (not on the first bar after a gap)
    if showTraps && !gap {
      let poke = pokePct / 100.0
      for k in 0..lvP.len {
        let st = lvState[k] ?? 3
        if st != 3 {
          let L = lvP[k] ?? 0.0
          let fixed = lvSide[k] ?? 0.0
          if st == 0 {
            if now >= (lvExp[k] ?? 0.0) {
              lvState[k] = 3
            } else {
              let dir = 0.0
              let downOk = fixed >= 0.0 && prevC5 > L && l < L * (1.0 - poke)
              let upOk = fixed <= 0.0 && prevC5 < L && h > L * (1.0 + poke)
              if downOk { dir = 1.0 } else if upOk { dir = -1.0 }
              if dir != 0.0 {
                lvState[k] = 1
                lvFlowOk[k] = flowOk
                lvDir[k] = dir
                lvFlush[k] = dir > 0.0 ? l : h
                lvBars[k] = 1
                lvHeld[k] = 0
                lvNew[k] = dir > 0.0 ? math.max(ns, 0.0) : math.max(nl, 0.0)
                lvStop[k] = liqOk ? (dir > 0.0 ? longLiq : shortLiq) : -1.0
                lvPv[k] = pp * vv
                lvV[k] = vv
                lvFrom[k] = t
                lvPressed[k] = 0.0
                lvPressedPv[k] = 0.0
                lvBack[k] = 0.0
                lvTradeOk[k] = true
                creditBar(k, dir, t, L, l, h, true, dir > 0.0 ? c > L : c < L)
                if dir > 0.0 ? c > L : c < L { lvState[k] = 2 }
              }
            }
          } else {
            let dir = lvDir[k] ?? 0.0
            let back = dir > 0.0 ? c > L : c < L
            lvBars[k] = (lvBars[k] ?? 0) + 1
            if st == 1 {
              creditBar(k, dir, t, L, l, h, true, back)
              lvFlowOk[k] = (lvFlowOk[k] ?? false) && flowOk
              lvFlush[k] = dir > 0.0 ? math.min(lvFlush[k] ?? l, l) : math.max(lvFlush[k] ?? h, h)
              lvNew[k] = (lvNew[k] ?? 0.0) + (dir > 0.0 ? math.max(ns, 0.0) : math.max(nl, 0.0))
              lvStop[k] = liqOk && (lvStop[k] ?? 0.0) >= 0.0 ? (lvStop[k] ?? 0.0) + (dir > 0.0 ? longLiq : shortLiq) : -1.0
              lvPv[k] = (lvPv[k] ?? 0.0) + pp * vv
              lvV[k] = (lvV[k] ?? 0.0) + vv
              if back {
                lvState[k] = 2
                lvHeld[k] = 0
              } else if (lvBars[k] ?? 0) > reclaimBars {
                // accepted beyond the level: a swing level is done, a VWAP level waits for the other direction
                lvState[k] = fixed != 0.0 ? 3 : 0
              }
            } else {
              let flushed = dir > 0.0 ? l < (lvFlush[k] ?? l) : h > (lvFlush[k] ?? h)
              if flushed || !back {
                if !flushed && (lvBars[k] ?? 0) <= reclaimBars {
                  lvState[k] = 1
                  // Failed reclaim: discard its back-volume before another attempt.
                  lvBack[k] = 0.0
                  creditBar(k, dir, t, L, l, h, true, false)
                  lvFlowOk[k] = (lvFlowOk[k] ?? false) && flowOk
                  lvNew[k] = (lvNew[k] ?? 0.0) + (dir > 0.0 ? math.max(ns, 0.0) : math.max(nl, 0.0))
                  lvStop[k] = liqOk && (lvStop[k] ?? 0.0) >= 0.0 ? (lvStop[k] ?? 0.0) + (dir > 0.0 ? longLiq : shortLiq) : -1.0
                  lvPv[k] = (lvPv[k] ?? 0.0) + pp * vv
                  lvV[k] = (lvV[k] ?? 0.0) + vv
                } else {
                  lvState[k] = fixed != 0.0 ? 3 : 0
                }
              } else {
                creditBar(k, dir, t, L, l, h, false, true)
                lvHeld[k] = (lvHeld[k] ?? 0) + 1
                if (lvHeld[k] ?? 0) >= holdBars {
                  lvState[k] = 3
                  // one trap per side per hour (nearby levels break together)
                  let sideKey = dir > 0.0 ? 1 : 0
                  if now - (lastTrap.get(sideKey) ?? -1000000000.0) >= 3600.0 {
                    lastTrap.set(sideKey, now)
                    let pain = (lvV[k] ?? 0.0) > 0.0 ? (lvPv[k] ?? 0.0) / (lvV[k] ?? 1.0) : L
                    let name = str.concat(lvName[k] ?? "", " ", priceText(L))
                    let pr = lvPressed[k] ?? 0.0
                    let tOk = (lvTradeOk[k] ?? false) && pr > 0.0
                    addTrap(dir, t, lvFrom[k] ?? t, lvNew[k] ?? 0.0, lvFlush[k] ?? L, pain, L, name, lvStop[k] ?? 0.0, false, lvFlowOk[k] ?? false, pr, tOk ? (lvPressedPv[k] ?? 0.0) / pr : pain, lvBack[k] ?? 0.0, tOk)
                  }
                }
              }
            }
          }
        }
      }
    }
    prevC5 = c
    prevT5 = now
  }
}

on chart.close {
  ensureListed()
  let o = chart.open
  let h = chart.high
  let l = chart.low
  let c = chart.close
  let t = chart.time
  if o != null && h != null && l != null && c != null && t != null {
    // row size as the delta ladder: a tenth of the recent average bar range, changed only when it doubles or halves
    ranges.push(h - l)
    let avgRange = ranges.avg() ?? 0.0
    let tick = markets.tickSize(context.exchange, context.symbol) ?? 0.0
    let auto = math.max(ranges.len >= 20 && avgRange > 0.0 ? niceStep(avgRange / 10.0) : niceStep(c * 0.0006 * tfScale), tick)
    if rowSize > 0.0 {
      step = rowSize
    } else if step <= 0.0 || auto >= step * 2.0 || auto <= step / 2.0 {
      step = auto
    }

    // close zones that this bar closed through
    if showZones {
      for k in 0..zLo.len {
        if zLive[k] ?? false {
          let lo = zLo[k] ?? 0.0
          let hi = zHi[k] ?? 0.0
          let sign = zSign[k] ?? 0.0
          let through = sign > 0.0 ? c < lo : c > hi
          if through {
            zLive[k] = false
            let tint = sign > 0.0 ? buyColor : sellColor
            let from = zFrom[k] ?? t
            zones.get(k).set(from, lo, t, hi, color: color.withAlpha(tint, 28), borderWidth: 0.0)
          }
        }
      }
    }

    // Fade proxy weights, add positive flow at HLC3, reduce weight on negative flow. A missing chart bar, or a bar
    // without every selected venue's candle and the open interest on it, resets the weights (see flowStep).
    let bv = useChart ? chart.buyVolume : (bnC.buyVolume ?? 0.0) + (bbC.buyVolume ?? 0.0) + (useAll ? (okC.buyVolume ?? 0.0) : 0.0)
    let sv = useChart ? chart.sellVolume : (bnC.sellVolume ?? 0.0) + (bbC.sellVolume ?? 0.0) + (useAll ? (okC.sellVolume ?? 0.0) : 0.0)
    let oo = oiAgg.open
    let oc = oiAgg.close
    let chartGap = prevChartT > 0.0 && unix(t) - prevChartT > tfSec
    prevChartT = unix(t)
    let fready = !chartGap && flowReadyClosed(t) && oiAgg.time == t && bv != null && sv != null && oo != null && oc != null
    let fd = (bv ?? 0.0) - (sv ?? 0.0)
    let fdOi = (oc ?? 0.0) - (oo ?? 0.0)
    flowStep(fready, (fdOi + fd) / 2.0, (fdOi - fd) / 2.0, (h + l + c) / 3.0, math.pow(0.5, 1.0 / halfLife) ?? 1.0)

    // the bar's rows: the largest, the wicks, the zones and the net
    let b = vol.bucketsByStep(step)
    let prior = lastDone
    if b != null && b.time == t && (prior == null || (prior != null && t > prior)) {
      lastDone = t
      let ref = math.max(peaks.avg() ?? 0.0, 0.000000001)
      let bodyTop = math.max(o, c)
      let bodyLow = math.min(o, c)
      let biggest = 0.0
      let upUsd = 0.0
      let lowUsd = 0.0
      let upCoins = 0.0
      let lowCoins = 0.0
      let upBuyUsd = 0.0
      let upBuyCoins = 0.0
      let lowSellUsd = 0.0
      let lowSellCoins = 0.0
      let net = 0.0
      let netUsd = 0.0
      let maxPrice = 0.0
      let maxUsd = 0.0
      let runLo = 0.0
      let runHi = 0.0
      let runSign = 0.0
      let haveRef = peaks.len >= 20
      for i in 0..b.len {
        let r = b.get(i)
        let mid = r != null ? (r.from + r.to) / 2.0 : 0.0
        let usd = r != null ? r.delta * mid : 0.0
        if r != null {
          net += r.delta
          netUsd += usd
          if math.abs(usd) > biggest {
            maxPrice = mid
            maxUsd = usd
          }
          biggest = math.max(biggest, math.abs(usd))
          if mid > bodyTop {
            upUsd += usd
            upCoins += r.delta
            if r.delta > 0.0 {
              upBuyUsd += usd
              upBuyCoins += r.delta
            }
          }
          if mid < bodyLow {
            lowUsd += usd
            lowCoins += r.delta
            if r.delta < 0.0 {
              lowSellUsd += usd
              lowSellCoins += r.delta
            }
          }
        }
        // runs of outsized rows of one sign become one zone
        let sign = usd > 0.0 ? 1.0 : -1.0
        let big = r != null && haveRef && math.abs(usd) >= zoneMult * ref
        if runSign != 0.0 && (!big || sign != runSign) {
          if showZones { addZone(runLo, runHi, runSign, t) }
          runSign = 0.0
        }
        if big && r != null {
          if runSign == 0.0 {
            runLo = r.from
            runSign = sign
          }
          runHi = r.to
        }
      }
      if runSign != 0.0 && showZones { addZone(runLo, runHi, runSign, t) }
      peaks.push(biggest)
      // agent export: this closed bar's delta rows (written on close, so they sit on the next bar; heat.bar_min
      // names the bar they describe)
      xHeatBar.plot(unix(t) / 60.0 - 29453760.0)
      xHeatMaxPrice.plot(biggest > 0.0 ? maxPrice : null)
      xHeatMaxUsd.plot(biggest > 0.0 ? maxUsd : null)
      xHeatNetUsd.plot(netUsd)
      xHeatUpperWickUsd.plot(upUsd)
      xHeatLowerWickUsd.plot(lowUsd)
      xHeatTypical.plot(ref)

      // divergence against the lookback's extreme
      cvd += net
      let topHigh = highs.max()
      let lowLow = lows.min()
      if highs.len >= 4 && topHigh != null && lowLow != null {
        let n = highs.len
        let bearDiv = false
        let bullDiv = false
        for i in 0..n {
          let hi = highs[i] ?? 0.0
          let lo = lows[i] ?? 0.0
          let then = cvds[i] ?? 0.0
          let at = times[i] ?? t
          // the earlier extreme, at least three bars back
          if i <= n - 3 && hi == topHigh && h > topHigh && cvd < then {
            if !bearDiv { nDiv += 1 }
            bearDiv = true
            divBearT = unix(t)
            divBearP = h
            if showDiv { divLines.get("b", t).set(at, hi, t, h, width: 1.5, color: sellColor, style: linestyle.dashed) }
          }
          if i <= n - 3 && lo == lowLow && l < lowLow && cvd > then {
            if !bullDiv { nDiv += 1 }
            bullDiv = true
            divBullT = unix(t)
            divBullP = l
            if showDiv { divLines.get("s", t).set(at, lo, t, l, width: 1.5, color: buyColor, style: linestyle.dashed) }
          }
        }
      }
      highs.push(h)
      lows.push(l)
      cvds.push(cvd)
      times.push(t)

      // old wick markers
      let range = h - l
      if showWick && haveRef && range > 0.0 {
        let barEnd = time.fromUnixSeconds(int(unix(t) + float(time.tfSeconds(context.timeframe)) - 300.0) ?? 0)
        if (h - bodyTop) / range >= wickMin && upUsd >= trapMult * ref {
          addTrap(-1.0, barEnd, t, math.max(upCoins, 0.000000001), h, upBuyCoins > 0.0 ? upBuyUsd / upBuyCoins : h, h, str.concat("wick ", money(upUsd)), 0.0, true, false, 0.0, h, 0.0, false)
        }
        if (bodyLow - l) / range >= wickMin && -lowUsd >= trapMult * ref {
          addTrap(1.0, barEnd, t, math.max(-lowCoins, 0.000000001), l, lowSellCoins < 0.0 ? lowSellUsd / lowSellCoins : l, l, str.concat("wick ", money(lowUsd)), 0.0, true, false, 0.0, l, 0.0, false)
        }
      }
    }
  }
}

fn xMin(t: time?) -> float? {
  return t != null ? unix(t) / 60.0 - 29453760.0 : null
}
fn xMinU(u: float) -> float? {
  return u > 0.0 ? u / 60.0 - 29453760.0 : null
}
// One side's newest trap into the export series (k < 0: none).
fn exportTrapL(k: int) {
  let has = k >= 0
  let pressed = has ? fPressed[k] ?? 0.0 : 0.0
  let tradeOk = has ? fTradeOk[k] ?? false : false
  let st = has ? fStatus[k] ?? "" : ""
  xLMin.plot(has ? xMin(fTime[k]) : null)
  xLLevel.plot(has ? fLvl[k] : null)
  xLStop.plot(has ? fExt[k] : null)
  xLAvgFill.plot(has ? fFill[k] : null)
  xLPressed.plot(has && tradeOk ? pressed : null)
  xLReclaimX.plot(has && tradeOk && pressed > 0.0 ? (fBack[k] ?? 0.0) / pressed : null)
  xLStoppedOut.plot(has && (fStopped[k] ?? 0.0) >= 0.0 ? fStopped[k] : null)
  xLBreakFlow.plot(has && (fFlowOk[k] ?? false) ? fQty[k] : null)
  xLCounterflow.plot(has && (fCounterOk[k] ?? false) && (fFlowOk[k] ?? false) ? fDone[k] : null)
  xLNetFlow.plot(has && (fCounterOk[k] ?? false) ? fNet[k] : null)
  xLStatus.plot(has ? ((fLive[k] ?? false) ? 1.0 : str.startsWith(st, "failed") ? -1.0 : 0.0) : null)
  xLTradeOk.plot(has ? (tradeOk ? 1.0 : 0.0) : null)
  xLWick.plot(has ? ((fWick[k] ?? false) ? 1.0 : 0.0) : null)
  xLBreakMin.plot(has ? xMin(fFrom[k]) : null)
}
fn exportTrapS(k: int) {
  let has = k >= 0
  let pressed = has ? fPressed[k] ?? 0.0 : 0.0
  let tradeOk = has ? fTradeOk[k] ?? false : false
  let st = has ? fStatus[k] ?? "" : ""
  xSMin.plot(has ? xMin(fTime[k]) : null)
  xSLevel.plot(has ? fLvl[k] : null)
  xSStop.plot(has ? fExt[k] : null)
  xSAvgFill.plot(has ? fFill[k] : null)
  xSPressed.plot(has && tradeOk ? pressed : null)
  xSReclaimX.plot(has && tradeOk && pressed > 0.0 ? (fBack[k] ?? 0.0) / pressed : null)
  xSStoppedOut.plot(has && (fStopped[k] ?? 0.0) >= 0.0 ? fStopped[k] : null)
  xSBreakFlow.plot(has && (fFlowOk[k] ?? false) ? fQty[k] : null)
  xSCounterflow.plot(has && (fCounterOk[k] ?? false) && (fFlowOk[k] ?? false) ? fDone[k] : null)
  xSNetFlow.plot(has && (fCounterOk[k] ?? false) ? fNet[k] : null)
  xSStatus.plot(has ? ((fLive[k] ?? false) ? 1.0 : str.startsWith(st, "failed") ? -1.0 : 0.0) : null)
  xSTradeOk.plot(has ? (tradeOk ? 1.0 : 0.0) : null)
  xSWick.plot(has ? ((fWick[k] ?? false) ? 1.0 : 0.0) : null)
  xSBreakMin.plot(has ? xMin(fFrom[k]) : null)
}
// The level being traded through, the nearest watched levels, live zones and divergences.
fn exportContext(c: float?) {
  let act = -1
  let above = -1.0
  let below = -1.0
  let watching = 0
  for k in 0..lvState.len {
    let st = lvState[k] ?? 3
    let pr = lvP[k] ?? 0.0
    if st == 1 || st == 2 {
      if act < 0 || (lvFrom[k] ?? time.fromUnixSeconds(0)) > (lvFrom[act] ?? time.fromUnixSeconds(0)) { act = k }
    }
    if st == 0 {
      watching += 1
      if c != null {
        if pr >= c && (above < 0.0 || pr < above) { above = pr }
        if pr < c && (below < 0.0 || pr > below) { below = pr }
      }
    }
  }
  xActPrice.plot(act >= 0 ? lvP[act] : null)
  xActDir.plot(act >= 0 ? lvDir[act] : null)
  xActFlush.plot(act >= 0 ? lvFlush[act] : null)
  xActState.plot(act >= 0 ? float(lvState[act] ?? 0) : null)
  xActHeld.plot(act >= 0 ? float(lvHeld[act] ?? 0) : null)
  xActBars.plot(act >= 0 ? float(lvBars[act] ?? 0) : null)
  xActFrom.plot(act >= 0 ? xMin(lvFrom[act]) : null)
  xWatchAbove.plot(above >= 0.0 ? above : null)
  xWatchBelow.plot(below >= 0.0 ? below : null)
  xWatchCount.plot(float(watching))
  let za = -1
  let zb = -1
  for k in 0..zLo.len {
    if (zLive[k] ?? false) && c != null {
      let lo = zLo[k] ?? 0.0
      let hi = zHi[k] ?? 0.0
      if lo > c && (za < 0 || lo < (zLo[za] ?? 0.0)) { za = k }
      if hi < c && (zb < 0 || hi > (zHi[zb] ?? 0.0)) { zb = k }
    }
  }
  xZoneAboveLo.plot(za >= 0 ? zLo[za] : null)
  xZoneAboveHi.plot(za >= 0 ? zHi[za] : null)
  xZoneAboveSign.plot(za >= 0 ? zSign[za] : null)
  xZoneBelowLo.plot(zb >= 0 ? zLo[zb] : null)
  xZoneBelowHi.plot(zb >= 0 ? zHi[zb] : null)
  xZoneBelowSign.plot(zb >= 0 ? zSign[zb] : null)
  xDivBearMin.plot(xMinU(divBearT))
  xDivBearPrice.plot(divBearT > 0.0 ? divBearP : null)
  xDivBullMin.plot(xMinU(divBullT))
  xDivBullPrice.plot(divBullT > 0.0 ? divBullP : null)
}

// The average entries along the bars, the forming bar included, with names and distances at the right edge.
on chart.update {
  ensureListed()
  // agent export: this bar's stats (live bar included), as the Bar Stats script computes them
  let xbv = useChart ? chart.forming.buyVolume : (bnC.forming.buyVolume ?? 0.0) + (bbC.forming.buyVolume ?? 0.0) + (useAll ? (okC.forming.buyVolume ?? 0.0) : 0.0)
  let xsv = useChart ? chart.forming.sellVolume : (bnC.forming.sellVolume ?? 0.0) + (bbC.forming.sellVolume ?? 0.0) + (useAll ? (okC.forming.sellVolume ?? 0.0) : 0.0)
  let xoo = oiAgg.forming.open
  let xoc = oiAgg.forming.close
  // only when every selected venue's forming candle and the open interest are on this bar; otherwise null, not a
  // partial or stale sum
  let xt = chart.forming.time
  let xReady = xt != null && liveFlowReady(xt)
  if xReady && xbv != null && xsv != null && xoo != null && xoc != null {
    let xd = xbv - xsv
    let xdo = xoc - xoo
    xBarPlusL.plot((xdo + xd) / 2.0)
    xBarPlusS.plot((xdo - xd) / 2.0)
    xBarBuy.plot(xbv)
    xBarSell.plot(xsv)
    xBarDelta.plot(xd)
    xBarOi.plot(xoc)
    xBarDOi.plot(xdo)
  } else {
    let none: float? = null
    xBarPlusL.plot(none)
    xBarPlusS.plot(none)
    xBarBuy.plot(none)
    xBarSell.plot(none)
    xBarDelta.plot(none)
    xBarOi.plot(none)
    xBarDOi.plot(none)
  }
  let xLiqOk = xt != null && liqC.forming.time == xt
  xBarLongLiq.plot(xLiqOk ? liqC.forming.buyLiq : null)
  xBarShortLiq.plot(xLiqOk ? liqC.forming.sellLiq : null)
  if chart.isLast {
    // the newest trap on each side (tracked or finished), for the corner panel at the bottom right
    let newestL = -1
    let newestS = -1
    for k in 0..fSide.len {
      let at = fTime[k]
      if (fSide[k] ?? 0.0) < 0.0 {
        if newestL < 0 || (at != null && at > (fTime[newestL] ?? at)) { newestL = k }
      } else {
        if newestS < 0 || (at != null && at > (fTime[newestS] ?? at)) { newestS = k }
      }
    }
    let watching = 0
    for k in 0..lvState.len {
      if (lvState[k] ?? 3) != 3 { watching += 1 }
    }
    script.setTitle(str.format("Swordfish Offside | traps {0} long, {1} short | {2} levels watched | {3} div | {4} zones", nTL, nTS, watching, nDiv, nZones))
    exportTrapL(newestL)
    exportTrapS(newestS)
    exportContext(chart.forming.close)
    if (showTraps || showWick) && newestL >= 0 {
      hud.get("L").set(12.0, 16.0 + textSize + 4.0, trapLine(newestL, "Trapped longs"), color: sellColor, size: textSize - 2.0, textAlign: "right")
    } else {
      hud.delete("L")
    }
    if (showTraps || showWick) && newestS >= 0 {
      hud.get("S").set(12.0, 16.0, trapLine(newestS, "Trapped shorts"), color: buyColor, size: textSize - 2.0, textAlign: "right")
    } else {
      hud.delete("S")
    }
  }
  if showEntries {
    let bv = useChart ? chart.forming.buyVolume : (bnC.forming.buyVolume ?? 0.0) + (bbC.forming.buyVolume ?? 0.0) + (useAll ? (okC.forming.buyVolume ?? 0.0) : 0.0)
    let sv = useChart ? chart.forming.sellVolume : (bnC.forming.sellVolume ?? 0.0) + (bbC.forming.sellVolume ?? 0.0) + (useAll ? (okC.forming.sellVolume ?? 0.0) : 0.0)
    let oo = oiAgg.forming.open
    let oc = oiAgg.forming.close
    let h = chart.forming.high
    let l = chart.forming.low
    let c = chart.forming.close
    let lq = lQty
    let lc = lCost
    let sq = sQty
    let sc = sCost
    let liveTime = chart.forming.time
    let ready = liveTime != null && flowReadyLive(liveTime) && oiAgg.forming.time == liveTime
    if ready && bv != null && sv != null && oo != null && oc != null && h != null && l != null && c != null {
      let d = bv - sv
      let dOi = oc - oo
      let nl = (dOi + d) / 2.0
      let ns = (dOi - d) / 2.0
      let p = (h + l + c) / 3.0
      if nl > 0.0 {
        lq += nl
        lc += nl * p
      } else if lq > 0.0 {
        let f = math.max(0.0, 1.0 + nl / lq)
        lq = lq * f
        lc = lc * f
      }
      if ns > 0.0 {
        sq += ns
        sc += ns * p
      } else if sq > 0.0 {
        let f = math.max(0.0, 1.0 + ns / sq)
        sq = sq * f
        sc = sc * f
      }
    }
    let la = ready && lq > 0.0 ? lc / lq : null
    let sa = ready && sq > 0.0 ? sc / sq : null
    longLine.plot(la)
    shortLine.plot(sa)
    if chart.isLast && c != null {
      if la != null {
        edge.get("L").set(8, la, str.format("+L flow price {0} | weight {1:,.0} {3} | distance {2:+.1%}", priceText(la), lq, c / la - 1.0, coin), color: longColor, size: textSize, textAlign: "right")
      } else { edge.delete("L") }
      if sa != null {
        edge.get("S").set(8, sa, str.format("+S flow price {0} | weight {1:,.0} {3} | distance {2:+.1%}", priceText(sa), sq, c / sa - 1.0, coin), color: shortColor, size: textSize, textAlign: "right")
      } else { edge.delete("S") }
    }
  }
}
