script "FLIMP BTC Aquarium v5"

// ----- FLIMP BTC Aquarium by FLIMP -----
// Version: 2026-10-13  v5.5 - verdict as a title (boxed/inverted when strong), more room above
//   the HUD, both tanks the same height, last-5-bars card in one row across both.
// v5.4 - pixel layout (anchor.topLeft): fixed size, no autoscale drift;
//   row numbers in a fixed monospace column at each tank's outer edge.
// v5.3 - perps and spot SIDE BY SIDE in one pane (View: Both/Perps/Spot),
//   wall rows setting (row height + font follow it), "fill/wall" row labels,
//   per-tank lane widths, perp share of width, venue status line.
//   Bubbles sink over exactly Wall rows x Flow row seconds, so a bubble sits
//   level with the wall row of the same moment.
// v5.2 - wall waterfall (outline = wall size, solid = hits) + verdicts
//
// v5.1 BOOK FLOW (replaces the scattered + / x marks of v4/v5):
//   v5.2 (FLIMP's design): OUTLINE = the WALL, SOLID = what HIT it.
//     OUTLINE = BTC resting in the watched bins on that side at the end of
//               the row (latest snapshot per venue, summed across the tank)
//     SOLID   = market orders that hit that side during the row
//   Read a row against the row BELOW it (older):
//     big outline, small solid       -> wall there, untested
//     solid reaching the outline     -> wall hit hard
//     outline narrower after a big solid  -> eaten, not refilled
//     outline narrower with no solid      -> pulled
//     outline holds after a big solid     -> REFILLED = absorption
//   (v5.1 below is superseded.)
//   Each side of each tank gets one bar pair per "Flow row" (default 5 s),
//   growing outward from the print lanes, newest row at the top:
//     OUTLINE = BTC that HIT that side (sells into bids / buys into asks)
//     SOLID   = NET BTC re-added on that side = fills + book change, summed
//               over the watched bins (adds minus pulls). v5.1a: was gross adds,
//               which market-maker churn inflated on both sides all the time.
//               Net <= 0 draws no solid (the label shows the signed net).
//   solid ~ outline -> refilled as fast as hit = ABSORPTION
//   solid >> outline -> that side is BUILDING (defending / pushing)
//   outline, no solid -> that side is being eaten and not replaced
//   No thresholds: one fixed absolute scale per tank (px per BTC).
//   Rows step every Flow row seconds; prints still sink smoothly.
//
// v5 LAYOUT: X = DISTANCE FROM PRICE, Y = TIME.
//   The dashed centre line is price. Prints sit in a lane either side of it
//   (buys left lane, sells right lane). Resting-order marks (+ / x) fan out
//   beyond the lanes at their real $ distance from price when they happened:
//   bids to the left, asks to the right, deeper = further out ("Book span").
//   Everything appears at the TOP when it happens and sinks to the bottom over
//   "Tank time span" seconds, so the tank reads as a waterfall: what happened
//   first is lower down. (v5.1: the book is drawn as flow bars, not marks.)
//
// v5 VERDICT (one line at the top of each tank), over the last "Verdict
//   window" seconds, from absolute BTC, the tank's price move and the book:
//   heavy buys + price moved < "Absorbed if price moves under" -> SELLERS ABSORBING
//   heavy buys + price moved + asks pulled > asks added        -> OFFERS PULLED
//   heavy buys + price moved + asks refilling                  -> BUYERS PUSHING THROUGH
//   buys were heavy last window, < half now, price stalled     -> BUYERS FADING
//   (mirrored for sells: BUYERS ABSORBING / BIDS PULLED / SELLERS PUSHING
//   THROUGH / SELLERS FADING). "Heavy" = at least the tank's Heavy threshold
//   AND 1.5x the other side. The stats line under it shows the raw numbers
//   the verdict used, so the thresholds can be tuned by eye.
//   Rolling windows live in per-second ring buffers written by each venue's
//   own trade handler (state written in chart.update only sticks at bar close).
//
// v4 - prints + resting orders in one tank
//   (v3.1 per-exchange slots + FLIMP BTC Limit Aquarium v1.1 merged)
//
// v4 ADDS RESTING ORDERS ON TOP OF THE PRINTS, same tanks, same sides:
//   LEFT = buy side   circles/diamonds = market BUYS,  + = BIDS added,  x = BIDS pulled
//   RIGHT = sell side circles/diamonds = market SELLS, + = ASKS added,  x = ASKS pulled
//   "+" = a book bin near price grew by at least "Smallest limit" since the
//   last snapshot (tape fills there are added back). "x" = it shrank by more
//   than the tape can explain - orders cancelled (or re-priced away).
//   Books are 5s snapshots binned $5 wide on BTC; trade handlers only see
//   COMPLETED book periods, so a 5m book would be frozen all bar (2026-10-13).
//   Each venue's book diff runs in that venue's own trade handler, at most
//   once per trade-second, and writes only that venue's limit slots.
//   The trade tapes are shared: subscribed at "Fill add-back from" so the
//   add-back sees small prints; bubbles and cascades still only use prints
//   >= "Smallest fish", exactly as v3.
//
// TWO TANKS, NOTHING ON THE PRICE CHART. Buys left, sells right in each.
//   PERPS - every perp venue.  SPOT - every spot venue (+ the status card).
//
// WHY EVERYTHING IS INDEXED BY EXCHANGE (learned the hard way, 2026-10-01)
//   MMT does not run the eight trade handlers one after another on one shared
//   state. Within one eval each handler appears to start from the same
//   snapshot, and the results are merged afterwards: `+=` on a number
//   accumulates, but a plain `=` from two handlers is last-writer-wins. With
//   one shared "next slot" counter, every exchange wrote its new bubble into
//   the same slots and the exchange processed LAST (Bybit/OKX spot) overwrote
//   the rest - so perps vanished and every bubble was yellow.
//   Rule now: a trade handler only ever writes elements it OWNS (its own slot
//   block, its own clock, its own cascade buckets) or uses `+=`. Only
//   chart.update (one handler) reads across exchanges, draws, and keeps the
//   drawing state; it never writes the slots the handlers own.
//
// DIAMONDS = one-second cascades on ONE exchange: several same-side fills in
//   the same second whose SUM reaches a bigger tier than any single fill.
//   Labelled with the fill count (x12), drawn at 60% size, live 1.5x.
//
// THE BAR (one per tank): net coins on screen (buys - sells) against its own
//   normal - an exponential average of the same number over "Bar normal
//   window" (default 600 s, recent seconds weighted most). Ticks at 1x and 2x,
//   full at "Bar full at". 2x or more = OUTSIZED.
//
// UNITS: BTC ("Show $ instead of BTC" flips every label).
// Subscriptions: chart, 5m regime feed, four trade tapes and four books.

input (
  input.section(title: "Size tiers (BTC)")
  fishMin = input.float(0.1, title: "Smallest fish", min: 0.0001, key: "fish_min", description: "Smallest print drawn as a bubble. (The tape itself is filtered at Fill add-back from.)")
  sharkMin = input.float(0.5, title: "Shark from", min: 0.0001, key: "shark_min", sameLine: true)
  orcaMin = input.float(1.0, title: "Killer whale from", min: 0.0001, key: "orca_min")
  blueMin = input.float(5.0, title: "Blue whale from", min: 0.0001, key: "blue_min", sameLine: true)
  showUsd = input.bool(false, title: "Show $ instead of BTC", key: "show_usd")
  labelMin = input.float(1.0, title: "Label bubbles from (BTC)", min: 0.0, key: "label_min", sameLine: true)

  input.section(title: "Tanks")
  viewMode = input.select("Both", title: "View", options: ["Both", "Perps", "Spot"], key: "view_mode", description: "Both = perps on the left, spot on the right, in one pane.")
  perpShare = input.float(0.5, title: "Perp share of width", min: 0.2, max: 0.8, key: "perp_share", sameLine: true, description: "With View = Both: how much of the pane width the perp tank takes.")
  perpHeight = input.float(0.4, title: "Pane height", min: 0.1, max: 1.0, key: "perp_h_frac")
  tankH = input.float(300.0, title: "Pane height (px)", min: 120.0, max: 2000.0, key: "tank_h", sameLine: true, description: "Your pane's height in pixels. Everything is laid out in pixels from the top, so set this to the pane's real height or the bottom gets cut off / left empty.")
  tankW = input.float(1000.0, title: "Tank width (px)", min: 300.0, max: 6000.0, key: "tank_w", description: "Your pane's width in pixels. MMT does not tell a script its pane size, so set this once.")
  perV = input.int(60, title: "Bubbles per exchange", min: 5, max: 150, key: "per_v", description: "Each exchange owns a block of this many bubble slots. When a busy venue prints more bubbles than this within the tank time, its oldest bubble is recycled and vanishes early. The venue line shows a venue at this number when it is full.")
  laneWP = input.float(80.0, title: "Perp bubble lane width (px)", min: 20.0, max: 600.0, key: "lane_wp", description: "Width of each perp print lane (buys left of price, sells right). Keep it wider than Max bubble size.")
  laneWS = input.float(60.0, title: "Spot bubble lane width (px)", min: 20.0, max: 600.0, key: "lane_ws", sameLine: true)
  tankScale = input.float(1.0, title: "Bubble scale", min: 0.2, max: 4.0, key: "tank_scale")
  maxBubble = input.float(32.0, title: "Max bubble size (px)", min: 8.0, max: 96.0, key: "max_bubble", sameLine: true, description: "Hard cap on a bubble's diameter, including the swell when it pops. Bubbles grow with the square root of their size; without a cap a 50 BTC print was ~90 px.")
  showCascades = input.bool(true, title: "One-second cascades", key: "show_casc")

  input.section(title: "Bar")
  normSecs = input.float(600.0, title: "Bar normal window (s)", min: 30.0, max: 7200.0, key: "norm_secs", description: "The bar compares net coins on screen with its own average over this window. Needs about this long after loading to settle.")
  barFull = input.float(3.0, title: "Bar full at (x normal)", min: 1.5, max: 10.0, key: "bar_full", sameLine: true)

  input.section(title: "Book flow")
  showLimits = input.bool(true, title: "Show book flow", key: "show_lim")
  showVerdict = input.bool(true, title: "Show verdict", key: "show_verdict", sameLine: true)
  showHits = input.bool(true, title: "Show hits inside walls", key: "show_hits", description: "The solid bar = market orders that hit that wall in the row. The same flow appears as bubbles in the opposite lane; turn off for walls only.")
  wallRows = input.int(8, title: "Wall rows", min: 3, max: 24, key: "wall_rows", description: "Number of rows in the waterfall. Fewer rows = taller rows and bigger numbers. Rows x Flow row seconds is also how long bubbles take to sink (max 115 s).")
  rowS = input.int(5, title: "Flow row (s)", min: 1, max: 30, key: "row_s", sameLine: true, description: "Seconds per flow row. Book snapshots arrive every few seconds, so 5 keeps rows from flickering between empty and full.")
  perpFull = input.float(200.0, title: "Perp wall full width at (BTC)", min: 1.0, max: 100000.0, key: "perp_full", description: "Fixed, absolute: a wall this big reaches the edge, half this big reaches halfway. Bigger walls are capped and drawn with a thick outline.")
  spotFull = input.float(50.0, title: "Spot wall full width at (BTC)", min: 0.5, max: 100000.0, key: "spot_full", sameLine: true)
  binsEach = input.int(3, title: "Bins watched each side", min: 1, max: 10, key: "bins_each", description: "Book bins below price (bids) and above price (asks) that make up the wall. 3 bins of $5 = the $15 nearest price.")
  fillMin = input.float(0.01, title: "Fill add-back from (BTC)", min: 0.0001, key: "fill_min", description: "Server-side tape filter. Prints this size and up are added back to the bin they hit, so a bin that was hit and refilled counts as re-added. Keep it at or below Smallest fish.")
  bookTf = input.timeframe(30s, title: "Book timeframe", key: "book_tf", sameLine: true, description: "Trade handlers only see COMPLETED book periods. MMT keeps every full-depth snapshot since the script started (about 48 KB each on BTC): 5s grew to ~230 MB per book in a few hours and froze the tank (2026-10-14), so 30s is the default.")
  bookStale = input.int(90, title: "Drop a book older than (s)", min: 6, max: 600, key: "book_stale", description: "Some venues' books arrive late or stall (seen 2026-10-13: Hyperliquid 5+ minutes behind). A venue whose latest snapshot is older than this is left OUT of the wall instead of repeating its last reading. Snapshots are Book timeframe buckets, so a healthy 30s book reads 30-60 s.")

  input.section(title: "Verdict")
  winS = input.int(30, title: "Verdict window (s)", min: 5, max: 60, key: "win_s")
  moveMax = input.float(15.0, title: "Absorbed if price moves under ($)", min: 0.5, key: "move_max", sameLine: true)
  perpHeavy = input.float(100.0, title: "Heavy perp flow (BTC per window)", min: 0.1, key: "perp_heavy", description: "Absolute BTC one side must trade in the window (and 1.5x the other side) to count as heavy. Tune against the stats line.")
  spotHeavy = input.float(20.0, title: "Heavy spot flow (BTC per window)", min: 0.1, key: "spot_heavy", sameLine: true)
  strongK = input.float(2.0, title: "Strong verdict at (x heavy)", min: 1.0, max: 10.0, key: "strong_k", description: "A verdict is drawn as a filled box (inverted) when the flow behind it is at least this many times the Heavy threshold; otherwise as coloured text.")

  input.section(title: "Colours")
  colourMode = input.select("By exchange", title: "Bubble colours", options: ["Buy / Sell", "By exchange"], key: "colour_mode")
  buyCol = input.color(color.rgb(59, 189, 217), title: "Buy", key: "buy_col")
  sellCol = input.color(color.rgb(240, 141, 202), title: "Sell", key: "sell_col", sameLine: true)
  textCol = input.color(color.rgb(200, 210, 222), title: "Text", key: "text_col", sameLine: true)
  pinCol = input.color(color.rgb(24, 23, 32), title: "Chart background", key: "pin_col", sameLine: true, description: "Colour of the two scale-holding lines at 0 and 1. MMT draws them even when transparent, so they are painted in your chart background colour to hide them.")

  input.section(title: "Perp venues")
  pV1 = input.exchange("binancef", title: "Perp 1", key: "p_v1")
  pU1 = input.bool(true, title: "Include", key: "p_u1", sameLine: true)
  pC1 = input.color(color.rgb(174, 94, 255), title: "Perp 1 colour", key: "p_c1", sameLine: true)
  pV2 = input.exchange("bybitf", title: "Perp 2", key: "p_v2")
  pU2 = input.bool(true, title: "Include", key: "p_u2", sameLine: true)
  pC2 = input.color(color.rgb(58, 233, 177), title: "Perp 2 colour", key: "p_c2", sameLine: true)

  input.section(title: "Spot venues")
  sV1 = input.exchange("binance", title: "Spot 1", key: "s_v1")
  sU1 = input.bool(true, title: "Include", key: "s_u1", sameLine: true)
  sC1 = input.color(color.rgb(255, 64, 183), title: "Spot 1 colour", key: "s_c1", sameLine: true)
  sV2 = input.exchange("coinbase", title: "Spot 2", key: "s_v2")
  sU2 = input.bool(true, title: "Include", key: "s_u2", sameLine: true)
  sC2 = input.color(color.rgb(0, 219, 255), title: "Spot 2 colour", key: "s_c2", sameLine: true)
)

// ----- Subscriptions (10) -----
// Trimmed 2026-10-14 to perps Binance + Bybit and spot Binance + Coinbase (4 tapes, 4 books, live only):
// the full eight-venue set (8 tapes + 8 books) left the tank frozen or blank in Dan's workspace. Perp 3/4 and
// spot 3/4 are unavailable; settings and status show only the four connected feeds.
data (
  chart = subscribe(data.ohlcv)
  m5 = subscribe(data.ohlcv, timeframe: tf("5m"), history: 600)
  tp1 = subscribe(data.trades, exchange: pV1, symbol: "btc/usd", minSize: fillMin, history: 0s)
  tp2 = subscribe(data.trades, exchange: pV2, symbol: "btc/usd", minSize: fillMin, history: 0s)
  ts1 = subscribe(data.trades, exchange: sV1, symbol: "btc/usd", minSize: fillMin, history: 0s)
  ts2 = subscribe(data.trades, exchange: sV2, symbol: "btc/usd", minSize: fillMin, history: 0s)
  bp1 = subscribe(data.book, exchange: pV1, symbol: "btc/usd", timeframe: bookTf, history: 0s)
  bp2 = subscribe(data.book, exchange: pV2, symbol: "btc/usd", timeframe: bookTf, history: 0s)
  bs1 = subscribe(data.book, exchange: sV1, symbol: "btc/usd", timeframe: bookTf, history: 0s)
  bs2 = subscribe(data.book, exchange: sV2, symbol: "btc/usd", timeframe: bookTf, history: 0s)
)

setup byExchange = colourMode == "By exchange"
setup tankN = perV * 8
// book memory: index (ven * 2 + side) * 10 + j, side 0 = bid, 1 = ask
setup memN = 160

pane perpPane = pane(title: "Aquarium", height: perpHeight)

// Vertical layout runs on a virtual height mapped onto each pane's value
// scale, pinned to 0..1 by two invisible lines, so heights follow the pane.
setup perpV = tankH
setup spotV = tankH
setup timeSpan = math.min(float(wallRows * rowS), 115.0)

plot (
  pinPLo = plot.line(title: "pin perp lo", color: pinCol, width: 1.0, showLabel: false, showValue: false, on: perpPane)
  pinPHi = plot.line(title: "pin perp hi", color: pinCol, width: 1.0, showLabel: false, showValue: false, on: perpPane)
)

state (
  uBub = entities.markerPool(max: tankN, on: perpPane, anchor: anchor.topLeft)
  uTag = entities.labelPool(max: tankN, on: perpPane, anchor: anchor.topLeft)
  uHud = entities.labelPool(max: 8, on: perpPane, anchor: anchor.topLeft)
  uFlow = entities.boxPool(max: 240, on: perpPane, anchor: anchor.topLeft)
  uFlab = entities.labelPool(max: 120, on: perpPane, anchor: anchor.topLeft)
  uBox = entities.boxPool(max: 3, on: perpPane, anchor: anchor.topLeft)
  uLine = entities.linePool(max: 7, on: perpPane, anchor: anchor.topLeft)
  sBub = entities.markerPool(max: tankN, on: perpPane, anchor: anchor.topLeft)
  sTag = entities.labelPool(max: tankN, on: perpPane, anchor: anchor.topLeft)
  sHud = entities.labelPool(max: 10, on: perpPane, anchor: anchor.topLeft)
  sFlow = entities.boxPool(max: 240, on: perpPane, anchor: anchor.topLeft)
  sFlab = entities.labelPool(max: 120, on: perpPane, anchor: anchor.topLeft)
  sBox = entities.boxPool(max: 3, on: perpPane, anchor: anchor.topLeft)
  sLine = entities.linePool(max: 7, on: perpPane, anchor: anchor.topLeft)
  cHud = entities.labelPool(max: 2, on: perpPane, anchor: anchor.topLeft)

  // ---- owned by the trade handlers: slot block [ven*perV, ven*perV+perV) ----
  ba = float[](tankN)
  brx = float[](tankN)
  bry = float[](tankN)
  bborn = float[](tankN)
  blife = float[](tankN)
  bq = float[](tankN)
  bbuy = float[](tankN)
  bcas = float[](tankN)
  bn = float[](tankN)
  vNext = float[](8)
  vSec = float[](8)
  vSpawn = float[](8)
  // cascade buckets, index ven*2 + side (0 buy, 1 sell)
  cQ = float[](16)
  cPv = float[](16)
  cN = float[](16)
  cMax = float[](16)
  // ---- limit marks, owned by the trade handlers: same slot blocks ----
  la = float[](tankN)
  lrx = float[](tankN)
  lry = float[](tankN)
  lborn = float[](tankN)
  llife = float[](tankN)
  lq = float[](tankN)
  lbid = float[](tankN)
  lpull = float[](tankN)
  lpx = float[](tankN)
  lNext = float[](8)
  lSpawn = float[](8)
  vChk = float[](8)
  vFp = float[](8)
  vBin = float[](8)
  vHave = float[](8)
  vPx = float[](8)
  vBookT = float[](8)
  ldist = float[](tankN)
  // per-second ring buffers, index ven * 120 + (second % 120)
  rSec = float[](960)
  rBuy = float[](960)
  rSell = float[](960)
  rBA = float[](960)
  rBP = float[](960)
  rAA = float[](960)
  rAP = float[](960)
  rPx = float[](960)
  rWB = float[](960)
  rWA = float[](960)
  // book memory (previous snapshot), new snapshot scratch, fills since then
  kPx = float[](memN)
  kQ = float[](memN)
  kF = float[](memN)
  nPx = float[](memN)
  nQ = float[](memN)
  // card totals: only ever `+=`
  totFish: float = 0.0
  totShark: float = 0.0
  totOrca: float = 0.0
  totBlue: float = 0.0
  totBuy: float = 0.0
  totSell: float = 0.0

  // ---- owned by chart.update / chart.close ----
  bdrawn = float[](tankN)
  ldrawn = float[](tankN)
  fRow = float[](960)
  vCnt = float[](8)
  fWb = float[](960)
  fWa = float[](960)
  fWs = float[](960)
  dSec: float = 0.0
  dFrames: float = 0.0
  netU: float = 0.0
  netS: float = 0.0
  normU: float = 0.0
  normS: float = 0.0
  snapFish = rolling<float>(6)
  snapShark = rolling<float>(6)
  snapOrca = rolling<float>(6)
  snapBlue = rolling<float>(6)
  snapBuy = rolling<float>(6)
  snapSell = rolling<float>(6)
  volX: float = 0.0
  skyX: float = 0.0
)

type Verdict {
  word: string
  tone: int
  stats: string
  strong: bool
}

// ----- Helpers (every local name unique) -----
fn tierOf(tq: float) -> int {
  return tq >= blueMin ? 3 : (tq >= orcaMin ? 2 : (tq >= sharkMin ? 1 : 0))
}

fn frac(fx: float, flo: float, fhi: float) -> float {
  return fhi > flo ? math.clamp((fx - flo) / (fhi - flo), 0.0, 1.0) : 1.0
}

fn money(usd: float) -> string {
  let mbody = usd >= 1000000.0 ? str.format("{0:.2}M", usd / 1000000.0) : str.format("{0:.1}K", usd / 1000.0)
  return str.concat("$", mbody)
}

fn coins(kq: float) -> string {
  return kq >= 10.0 ? str.format("{0:.1} BTC", kq) : str.format("{0:.2} BTC", kq)
}

fn amt(aq: float, apx: float) -> string {
  return showUsd ? money(aq * apx) : coins(aq)
}

fn signedAmt(gq: float, gpx: float) -> string {
  return str.concat(gq >= 0.0 ? "+" : "-", amt(math.abs(gq), gpx))
}

fn skyWord(skx: float) -> string {
  return skx <= 0.0 ? "sky ..." : (skx < 0.7 ? "calm" : (skx < 1.3 ? "breezy" : (skx < 2.0 ? "choppy" : "STORM")))
}

fn rnd(seed: float) -> float {
  let rv = math.sin(seed) * 43758.5453
  return rv - math.floor(rv)
}

// Labels pivot on their top-left corner; right/centre alignment estimates width.
fn textW(ts: string, tsz: float) -> float {
  return float(ts.len) * tsz * 0.6
}

fn countTier(ct2: int) {
  if ct2 == 3 {
    totBlue += 1.0
  } else if ct2 == 2 {
    totOrca += 1.0
  } else if ct2 == 1 {
    totShark += 1.0
  } else {
    totFish += 1.0
  }
}

fn bubbleSize(zq: float) -> float {
  let zr = math.sqrt(math.max(zq, 0.000001) / math.max(fishMin, 0.000001)) ?? 1.0
  return math.clamp(4.0 * zr * tankScale, 3.0, maxBubble)
}


fn venueColour(cv: int, cBuy: bool) -> color {
  if byExchange == false {
    return cBuy ? buyCol : sellCol
  }
  if cv == 0 {
    return pC1
  }
  if cv == 1 {
    return pC2
  }
  if cv == 4 {
    return sC1
  }
  return sC2
}

// Virtual y (0 = top) -> pane value. The layout spans [-edgePad, 1+edgePad]
// so it runs into MMT's own autoscale margin instead of leaving it empty.
// v5.4: every pool is anchor.topLeft, so x AND y are logical pixels from the
// pane's top-left corner. Layout no longer depends on the pane's value scale,
// so MMT's autoscale cannot resize or misalign it. yP/yS stay as no-ops.
fn yP(py: float) -> float {
  return py
}

fn yS(sy: float) -> float {
  return sy
}

// Called from chart.update only (one handler), so the pushes cannot collide.
fn tankInit() {
  if ba.len > 0 {
    return
  }
  for ii in 0..tankN {
    ba.push(0.0)
    brx.push(0.0)
    bry.push(0.0)
    bborn.push(0.0)
    blife.push(0.0)
    bq.push(0.0)
    bbuy.push(0.0)
    bcas.push(0.0)
    bn.push(0.0)
    bdrawn.push(0.0)
    la.push(0.0)
    lrx.push(0.0)
    lry.push(0.0)
    lborn.push(0.0)
    llife.push(0.0)
    lq.push(0.0)
    lbid.push(0.0)
    lpull.push(0.0)
    lpx.push(0.0)
    ldist.push(0.0)
    ldrawn.push(0.0)
  }
  for vc in 0..8 {
    vCnt.push(0.0)
  }
  for fr in 0..960 {
    fRow.push(0.0)
    fWb.push(0.0)
    fWa.push(0.0)
    fWs.push(0.0)
  }
  for jj in 0..8 {
    vNext.push(0.0)
    vSec.push(0.0)
    vSpawn.push(0.0)
    lNext.push(0.0)
    lSpawn.push(0.0)
    vChk.push(0.0)
    vFp.push(0.0)
    vBin.push(0.0)
    vHave.push(0.0)
    vPx.push(0.0)
    vBookT.push(0.0)
  }
  for rr in 0..960 {
    rSec.push(0.0)
    rBuy.push(0.0)
    rSell.push(0.0)
    rBA.push(0.0)
    rBP.push(0.0)
    rAA.push(0.0)
    rAP.push(0.0)
    rPx.push(0.0)
    rWB.push(0.0)
    rWA.push(0.0)
  }
  for mm in 0..memN {
    kPx.push(0.0)
    kQ.push(0.0)
    kF.push(0.0)
    nPx.push(0.0)
    nQ.push(0.0)
  }
  for kk in 0..16 {
    cQ.push(0.0)
    cPv.push(0.0)
    cN.push(0.0)
    cMax.push(0.0)
  }
}

// Writes only slot block of `sven`.
fn spawnBubble(sven: int, sBuy: bool, sq: float, spx: float, sn: float, sborn: float) {
  let k = int(vNext[sven] ?? 0.0) ?? 0
  vNext[sven] = k >= perV - 1 ? 0.0 : float(k + 1)
  vSpawn[sven] = (vSpawn[sven] ?? 0.0) + 1.0
  let si = sven * perV + k
  let sseq = vSpawn[sven] ?? 0.0
  ba[si] = 1.0
  brx[si] = rnd(spx * 0.731 + sq * 13.7 + sseq * 1.618 + float(sven) * 7.77)
  bry[si] = rnd(spx * 1.913 + sseq * 2.414 + sq * 7.1 + float(sven) * 3.33)
  bborn[si] = sborn
  blife[si] = timeSpan
  bq[si] = sq
  bbuy[si] = sBuy ? 1.0 : 0.0
  bcas[si] = sn > 1.0 ? 1.0 : 0.0
  bn[si] = sn
}

// Ring bucket of (ven, second), reset when it last held a different second.
// Called only from that venue's own trade handler.
fn rTouch(tven: int, tsec: float) -> int {
  // no % operator in v3: modulo by floor
  let tmod = tsec - math.floor(tsec / 120.0) * 120.0
  let tix = tven * 120 + (int(tmod) ?? 0)
  if (rSec[tix] ?? -1.0) != tsec {
    rSec[tix] = tsec
    rBuy[tix] = 0.0
    rSell[tix] = 0.0
    rBA[tix] = 0.0
    rBP[tix] = 0.0
    rAA[tix] = 0.0
    rAP[tix] = 0.0
    rPx[tix] = 0.0
    rWB[tix] = 0.0
    rWA[tix] = 0.0
  }
  return tix
}

// Writes only cascade buckets of `fven`.
fn flushVenue(fven: int, fborn: float) {
  for fs in 0..2 {
    let fb = fven * 2 + fs
    let cq = cQ[fb] ?? 0.0
    let cn = cN[fb] ?? 0.0
    if cn >= 2.0 && cq >= sharkMin {
      let ct = tierOf(cq)
      if ct > tierOf(cMax[fb] ?? 0.0) {
        countTier(ct)
        if showCascades {
          spawnBubble(fven, fs == 0, cq, (cPv[fb] ?? 0.0) / cq, cn, fborn)
        }
      }
    }
    cQ[fb] = 0.0
    cPv[fb] = 0.0
    cN[fb] = 0.0
    cMax[fb] = 0.0
  }
}

// Every venue's tape lands here. ven: 0-3 perps, 4-7 spot.
fn onPrint(ven: int, ot: time, opx: float, oq: float, oBuy: bool) {
  if ba.len == 0 {
    return
  }
  let osec = float(time.unixSeconds(ot) ?? 0)
  let vs = vSec[ven] ?? 0.0
  if osec > vs {
    // A cascade is only known when the venue's NEXT second arrives. On a quiet
    // venue that can be many seconds later, and drawing it at its true time made
    // it pop in near the bottom and sit there. Late ones start at the top instead.
    flushVenue(ven, osec - vs > 3.0 ? osec : vs)
    vSec[ven] = osec
  }
  if oq >= fishMin {
    let ob = ven * 2 + (oBuy ? 0 : 1)
    cQ[ob] = (cQ[ob] ?? 0.0) + oq
    cPv[ob] = (cPv[ob] ?? 0.0) + oq * opx
    cN[ob] = (cN[ob] ?? 0.0) + 1.0
    cMax[ob] = math.max(cMax[ob] ?? 0.0, oq)
    countTier(tierOf(oq))
    if oBuy {
      totBuy += oq
    } else {
      totSell += oq
    }
    spawnBubble(ven, oBuy, oq, opx, 1.0, math.max(osec, vs))
  }
  vPx[ven] = opx
  let rI = rTouch(ven, math.max(osec, vs))
  if oBuy {
    rBuy[rI] = (rBuy[rI] ?? 0.0) + oq
  } else {
    rSell[rI] = (rSell[rI] ?? 0.0) + oq
  }
  rPx[rI] = opx
  if showLimits {
    limFill(ven, opx, oq, oBuy)
  }
}

// ===== Resting orders =====
// Index of the remembered bin of (ven, side) at price wp, or -1.
fn findBin(wven: int, wside: int, wp: float, wbin: float) -> int {
  let wfound = -1
  for wj in 0..binsEach {
    let wi = (wven * 2 + wside) * 10 + wj
    if wfound < 0 && math.abs((kPx[wi] ?? 0.0) - wp) < wbin * 0.25 && (kPx[wi] ?? 0.0) > 0.0 {
      wfound = wi
    }
  }
  return wfound
}

// Add a print back to the bin it hit. Sells hit bids, buys lift asks. Bin
// labels are edges, so try the bin the price floors into, then the neighbour.
fn limFill(fven: int, fpx: float, fq: float, fBuy: bool) {
  let fbin = vBin[fven] ?? 0.0
  if (vHave[fven] ?? 0.0) < 0.5 || fbin <= 0.0 {
    return
  }
  let fside = fBuy ? 1 : 0
  let ffloor = math.floor(fpx / fbin) * fbin
  let fi = findBin(fven, fside, ffloor, fbin)
  let fi2 = fi >= 0 ? fi : findBin(fven, fside, fBuy ? ffloor + fbin : ffloor - fbin, fbin)
  if fi2 >= 0 {
    kF[fi2] = (kF[fi2] ?? 0.0) + fq
  }
}

// True at most once per trade-second per venue: time to read the book.
fn wantCheck(cven: int, ct: time) -> bool {
  if showLimits == false || ba.len == 0 {
    return false
  }
  let csec = float(time.unixSeconds(ct) ?? 0)
  if csec > (vChk[cven] ?? 0.0) {
    vChk[cven] = csec
    return true
  }
  return false
}

fn clearNew(xven: int) {
  for xj in 0..20 {
    let xi = xven * 20 + xj
    nPx[xi] = 0.0
    nQ[xi] = 0.0
  }
}

fn putLv(lven: int, lside: int, lj: int, lpv: float, lqv: float) {
  let li = (lven * 2 + lside) * 10 + lj
  nPx[li] = lpv
  nQ[li] = lqv
}

// Compare the venue's new snapshot (nPx/nQ) with the remembered one.
fn diffVenue(dven: int, dbin: float) {
  if dbin <= 0.0 {
    return
  }
  let dfp = 0.0
  for dj in 0..binsEach {
    let dbi = (dven * 2) * 10 + dj
    let dai = (dven * 2 + 1) * 10 + dj
    dfp += (nQ[dbi] ?? 0.0) * 1.0 + (nQ[dai] ?? 0.0) * 1.7 + (nPx[dbi] ?? 0.0) * 0.001
  }
  let dhave = (vHave[dven] ?? 0.0) > 0.5
  // wall size now (every check, refreshed or not), for the waterfall outline
  let dwb = 0.0
  let dwa = 0.0
  for dw in 0..binsEach {
    dwb += nQ[(dven * 2) * 10 + dw] ?? 0.0
    dwa += nQ[(dven * 2 + 1) * 10 + dw] ?? 0.0
  }
  let dwi = rTouch(dven, vSec[dven] ?? 0.0)
  // stale book: record -1 so the waterfall drops this venue instead of carrying an old wall
  let dbAge = (vSec[dven] ?? 0.0) - (vBookT[dven] ?? 0.0)
  let dStale = dbAge > float(bookStale)
  rWB[dwi] = dStale ? -1.0 : dwb
  rWA[dwi] = dStale ? -1.0 : dwa
  // Book not refreshed since last look: keep collecting fills, change nothing.
  if dhave && math.abs(dfp - (vFp[dven] ?? 0.0)) < 0.0000001 {
    return
  }
  let dborn = vSec[dven] ?? 0.0
  if dhave {
    for ds in 0..2 {
      for dk in 0..binsEach {
        let dni = (dven * 2 + ds) * 10 + dk
        let dp = nPx[dni] ?? 0.0
        if dp > 0.0 {
          let doi = findBin(dven, ds, dp, dbin)
          if doi >= 0 {
            let dg = (nQ[dni] ?? 0.0) - (kQ[doi] ?? 0.0) + (kF[doi] ?? 0.0)
            let dri = rTouch(dven, dborn)
            if ds == 0 {
              if dg > 0.0 {
                rBA[dri] = (rBA[dri] ?? 0.0) + dg
              } else {
                rBP[dri] = (rBP[dri] ?? 0.0) - dg
              }
            } else {
              if dg > 0.0 {
                rAA[dri] = (rAA[dri] ?? 0.0) + dg
              } else {
                rAP[dri] = (rAP[dri] ?? 0.0) - dg
              }
            }
          }
        }
      }
    }
  }
  for es in 0..2 {
    for ek in 0..10 {
      let ei = (dven * 2 + es) * 10 + ek
      kPx[ei] = nPx[ei] ?? 0.0
      kQ[ei] = nQ[ei] ?? 0.0
      kF[ei] = 0.0
    }
  }
  vFp[dven] = dfp
  vBin[dven] = dbin
  vHave[dven] = 1.0
}

fn num(nv: float) -> string {
  return nv >= 10.0 ? str.format("{0:.0}", nv) : str.format("{0:.1}", nv)
}

fn shortVen(sn: string) -> string {
  return sn
}

// "binanc 12 (0s)" = bubbles on screen from that venue, seconds since its last print.
fn venTxt(tv: int, tname: string, tnow: float) -> string {
  let tls = vSec[tv] ?? 0.0
  let tage = tls > 0.0 ? str.format("{0:.0}s", math.max(tnow - tls, 0.0)) : "--"
  // book age = how old the latest book snapshot is; climbing = that book has stopped updating
  let tbt = vBookT[tv] ?? 0.0
  let tbage = tbt > 0.0 ? str.format("{0:.0}s", math.max(tnow - tbt, 0.0)) : "--"
  return str.format("{0} {1} ({2}, book {3})", shortVen(tname), int(vCnt[tv] ?? 0.0) ?? 0, tage, tbage)
}

fn signedUsd(su: float) -> string {
  return str.concat(su >= 0.0 ? "+" : "-", str.format("{0:.0}", math.abs(su)))
}

fn judge(jB: float, jS: float, jBprev: float, jSprev: float, jBA: float, jBP: float, jAA: float, jAP: float, jDP: float, jHeavy: float, jHasPx: bool, jpx: float) -> Verdict {
  let jstats = str.format("{0}s  B {1}  S {2}  px {3}  bid +{4} x{5}  ask +{6} x{7}", winS, num(jB), num(jS), jHasPx ? signedUsd(jDP) : "n/a", num(jBA), num(jBP), num(jAA), num(jAP))
  let buyDom = jB >= jHeavy && jB >= 1.5 * jS
  let sellDom = jS >= jHeavy && jS >= 1.5 * jB
  let jStalled = math.abs(jDP) < moveMax
  let jSB = jB >= strongK * jHeavy
  let jSS = jS >= strongK * jHeavy
  let jSBp = jBprev >= strongK * jHeavy
  let jSSp = jSprev >= strongK * jHeavy
  if jHasPx && buyDom {
    if jDP < moveMax {
      return Verdict { word: "SELLERS ABSORBING", tone: -1, stats: jstats, strong: jSB }
    }
    if jAP > jAA {
      return Verdict { word: "OFFERS PULLED", tone: 1, stats: jstats, strong: jSB }
    }
    return Verdict { word: "BUYERS PUSHING THROUGH", tone: 1, stats: jstats, strong: jSB }
  }
  if jHasPx && sellDom {
    if jDP > 0.0 - moveMax {
      return Verdict { word: "BUYERS ABSORBING", tone: 1, stats: jstats, strong: jSS }
    }
    if jBP > jBA {
      return Verdict { word: "BIDS PULLED", tone: -1, stats: jstats, strong: jSS }
    }
    return Verdict { word: "SELLERS PUSHING THROUGH", tone: -1, stats: jstats, strong: jSS }
  }
  if jHasPx && jStalled && jBprev >= jHeavy && jB < 0.5 * jBprev {
    return Verdict { word: "BUYERS FADING", tone: -1, stats: jstats, strong: jSBp }
  }
  if jHasPx && jStalled && jSprev >= jHeavy && jS < 0.5 * jSprev {
    return Verdict { word: "SELLERS FADING", tone: 1, stats: jstats, strong: jSSp }
  }
  return Verdict { word: "balanced", tone: 0, stats: jstats, strong: false }
}

fn tankDraw(px: float) {
  // clock: newest second any exchange has reached, plus a sub-second step per
  // frame (MMT redraws about every 0.5 s)
  let dmax = 0.0
  for cj in 0..8 {
    dmax = math.max(dmax, vSec[cj] ?? 0.0)
  }
  if dmax > dSec {
    let gap = dSec > 0.0 ? math.clamp(dmax - dSec, 1.0, 60.0) : 1.0
    let na = math.min(1.0, gap / normSecs)
    normU = normU <= 0.0 ? math.abs(netU) : normU + (math.abs(netU) - normU) * na
    normS = normS <= 0.0 ? math.abs(netS) : normS + (math.abs(netS) - normS) * na
    dSec = dmax
    dFrames = 0.0
  } else {
    dFrames += 1.0
  }
  let now = dSec + math.min(0.5 * dFrames, 0.95)
  let top = 84.0
  let uBottom = perpV - 40.0
  let sBottom = spotV - 40.0
  // tank geometry: View picks which tanks show; Both puts them side by side
  let uOn = viewMode != "Spot"
  let sOn = viewMode != "Perps"
  let tGap = 16.0
  let uX0 = 0.0
  let uW = uOn && sOn ? tankW * perpShare - tGap / 2.0 : tankW
  let sX0 = uOn && sOn ? tankW * perpShare + tGap / 2.0 : 0.0
  let sW = tankW - sX0
  let uCx = uX0 + uW / 2.0
  let sCx = sX0 + sW / 2.0
  for vz in 0..8 {
    vCnt[vz] = 0.0
  }

  let uBuy = 0.0
  let uSell = 0.0
  let nUB = 0
  let nUS = 0
  let sBuy = 0.0
  let sSell = 0.0
  let nSB = 0
  let nSS = 0
  let bigOn = 0.0

  for dv in 0..8 {
    let isPerp = dv < 4
    for dk in 0..perV {
      let i = dv * perV + dk
      let age = now - (bborn[i] ?? 0.0)
      let life = math.max(blife[i] ?? 1.0, 0.5)
      let alive = (isPerp ? uOn : sOn) && (ba[i] ?? 0.0) > 0.5 && age < life && age > -5.0
      if alive == false {
        // Delete on every frame once dead. bdrawn lives in chart.update state, which
        // rolls back until bar close, so a bubble born AND dead inside one bar was
        // never deleted and froze at the bottom (2026-10-13).
        // only for ~10 s after death: deleting every dead slot on every frame
        // (hundreds with Bubbles per exchange raised) blew the 500 ms wall budget
        if (ba[i] ?? 0.0) > 0.5 && age < life + 10.0 {
          if isPerp {
            uBub.delete("b", i)
            uTag.delete("t", i)
          } else {
            sBub.delete("b", i)
            sTag.delete("t", i)
          }
          bdrawn[i] = 0.0
        }
      } else {
        let q = bq[i] ?? 0.0
        let isBuy = (bbuy[i] ?? 0.0) > 0.5
        let isCas = (bcas[i] ?? 0.0) > 0.5
        let agep = math.max(age, 0.0)
        let grow = math.clamp(agep / 0.35, 0.0, 1.0)
        let popStart = life - 0.45
        let popping = agep > popStart
        let popK = popping ? math.clamp((agep - popStart) / 0.45, 0.0, 1.0) : 0.0
        let base = bubbleSize(q) * (isCas ? 0.6 : 1.0)
        let sz = math.clamp(base * (0.55 + 0.45 * grow) * (1.0 + 0.6 * popK), 1.0, maxBubble)
        let fade = 1.0 - 0.55 * (agep / life)
        let al = (popping ? 1.0 - popK : fade) * 230.0
        let c = color.withAlpha(venueColour(dv, isBuy), int(math.clamp(al, 0.0, 255.0)) ?? 0)
        let pad = sz / 2.0 + 2.0
        let bcx = isPerp ? uCx : sCx
        let blw = isPerp ? laneWP : laneWS
        let laneSpan = math.max(blw - 2.0 * pad, 1.0)
        let x = isBuy ? bcx - 6.0 - pad - laneSpan * (brx[i] ?? 0.5) : bcx + 6.0 + pad + laneSpan * (brx[i] ?? 0.5)
        vCnt[dv] = (vCnt[dv] ?? 0.0) + 1.0
        let bottom = isPerp ? uBottom : sBottom
        let y = top + 4.0 + pad + math.max(bottom - top - 8.0 - 2.0 * pad, 1.0) * math.clamp(agep / timeSpan, 0.0, 1.0)
        let shp = isCas ? shape.diamond : shape.circle
        let txt = isCas ? str.format("{0} x{1}", amt(q, px), int(bn[i] ?? 1.0) ?? 1) : amt(q, px)
        let tx = x - textW(txt, 10.0) / 2.0
        let ty = y - sz / 2.0 - 13.0
        bigOn = math.max(bigOn, q)
        bdrawn[i] = 1.0
        if isPerp {
          uBub.get("b", i).set(x: x, y: yP(y), shape: shp, color: c, size: sz, zIndex: tierOf(q))
          if q >= labelMin {
            uTag.get("t", i).set(x: tx, y: yP(ty), text: txt, color: c, size: 10.0, zIndex: 5)
          } else {
            uTag.delete("t", i)
          }
          if isBuy {
            uBuy += q
            nUB += 1
          } else {
            uSell += q
            nUS += 1
          }
        } else {
          sBub.get("b", i).set(x: x, y: yS(y), shape: shp, color: c, size: sz, zIndex: tierOf(q))
          if q >= labelMin {
            sTag.get("t", i).set(x: tx, y: yS(ty), text: txt, color: c, size: 10.0, zIndex: 5)
          } else {
            sTag.delete("t", i)
          }
          if isBuy {
            sBuy += q
            nSB += 1
          } else {
            sSell += q
            nSS += 1
          }
        }
      }
    }
  }

  // ---- wall waterfall: per row, OUTLINE = wall size, SOLID = hits ----
  let fRowS = float(rowS)
  let fRows = int(math.clamp(math.min(float(wallRows), math.floor(115.0 / fRowS)), 1.0, 24.0)) ?? 12
  for fz in 0..960 {
    fRow[fz] = 0.0
    fWb[fz] = 0.0
    fWa[fz] = 0.0
    fWs[fz] = 0.0
  }
  if showLimits {
    for fv in 0..8 {
      let fTank = fv >= 4 ? 1 : 0
      for fk in 0..120 {
        let fi = fv * 120 + fk
        let fst = rSec[fi] ?? 0.0
        let fage = dSec - fst
        if fst > 0.0 && fage >= 0.0 {
          // rows are anchored to fixed clock slots, so a finished row never changes
          let fr2 = int(math.floor(dSec / fRowS) - math.floor(fst / fRowS)) ?? 999
          if fr2 < fRows {
            let fBidHit = ((fTank * 2 + 0) * 2 + 0) * 120 + fr2
            let fAskHit = ((fTank * 2 + 1) * 2 + 0) * 120 + fr2
            fRow[fBidHit] = (fRow[fBidHit] ?? 0.0) + (rSell[fi] ?? 0.0)
            fRow[fAskHit] = (fRow[fAskHit] ?? 0.0) + (rBuy[fi] ?? 0.0)
            // wall: keep this venue's LATEST reading inside the row
            let fwi = fv * 120 + fr2
            let fwb = rWB[fi] ?? 0.0
            let fwa = rWA[fi] ?? 0.0
            if (fwb != 0.0 || fwa != 0.0) && fst > (fWs[fwi] ?? 0.0) {
              fWs[fwi] = fst
              fWb[fwi] = fwb
              fWa[fwi] = fwa
            }
          }
        }
      }
    }
    // sum walls across venues, oldest row first, carrying a venue's last
    // reading forward through rows where it had no snapshot
    for fv2 in 0..8 {
      let fT2 = fv2 >= 4 ? 1 : 0
      let fCarB = 0.0
      let fCarA = 0.0
      for fq in 0..120 {
        let fr4 = 119 - fq
        if fr4 < fRows {
          let fwj = fv2 * 120 + fr4
          if (fWs[fwj] ?? 0.0) > 0.0 {
            fCarB = math.max(fWb[fwj] ?? 0.0, 0.0)
            fCarA = math.max(fWa[fwj] ?? 0.0, 0.0)
          }
          let fBidW = ((fT2 * 2 + 0) * 2 + 1) * 120 + fr4
          let fAskW = ((fT2 * 2 + 1) * 2 + 1) * 120 + fr4
          fRow[fBidW] = (fRow[fBidW] ?? 0.0) + fCarB
          fRow[fAskW] = (fRow[fAskW] ?? 0.0) + fCarA
        }
      }
    }
  }
  for ft in 0..2 {
    let fPerp = ft == 0
    let fBot = fPerp ? uBottom : sBottom
    let fRowH = (fBot - top - 12.0) / math.max(float(fRows), 1.0)
    let fCx = fPerp ? uCx : sCx
    let fX0 = fPerp ? uX0 : sX0
    let fTw = fPerp ? uW : sW
    let fInner = 6.0 + (fPerp ? laneWP : laneWS) + 4.0
    let fFont = math.clamp(fRowH * 0.7, 7.0, 18.0)
    // numbers sit in a fixed column at the tank's outer edge; bars stop short of it
    let fLabCol = textW("000/000", fFont) + 8.0
    let fMaxLen = math.max(fTw / 2.0 - fInner - 4.0 - fLabCol, 10.0)
    let fScale = fMaxLen / math.max(fPerp ? perpFull : spotFull, 0.0001)
    let fFullBtc = fPerp ? perpFull : spotFull
    let fTankOn = fPerp ? uOn : sOn
    for fsd in 0..2 {
      let fIsBid = fsd == 0
      let fCol = fIsBid ? buyCol : sellCol
      // rows can never exceed 24 (Wall rows max); looping 120 issued ~1,400 deletes a frame
      for fr3 in 0..24 {
        let fKey = fsd * 120 + fr3
        let fHit = fRow[((ft * 2 + fsd) * 2 + 0) * 120 + fr3] ?? 0.0
        let fAdd = fRow[((ft * 2 + fsd) * 2 + 1) * 120 + fr3] ?? 0.0
        let fOn = showLimits && fTankOn && fr3 < fRows && (fHit > 0.0 || fAdd > 0.0)
        if fOn == false {
          if fPerp {
            uFlow.delete("h", fKey)
            uFlow.delete("a", fKey)
            uFlab.delete("n", fKey)
          } else {
            sFlow.delete("h", fKey)
            sFlow.delete("a", fKey)
            sFlab.delete("n", fKey)
          }
        } else {
          let fy1 = top + 6.0 + fRowH * float(fr3) + 1.0
          let fy2 = fy1 + math.max(fRowH - 2.0, 1.0)
          let fyA1 = fy1 + (fy2 - fy1) * 0.2
          let fyA2 = fy1 + (fy2 - fy1) * 0.8
          let fHitLen = math.min(fHit * fScale, fMaxLen)
          let fAddLen = math.min(math.max(fAdd, 0.0) * fScale, fMaxLen)
          let fHx1 = fIsBid ? fCx - fInner - fHitLen : fCx + fInner
          let fHx2 = fIsBid ? fCx - fInner : fCx + fInner + fHitLen
          let fAx1 = fIsBid ? fCx - fInner - fAddLen : fCx + fInner
          let fAx2 = fIsBid ? fCx - fInner : fCx + fInner + fAddLen
          let fAge01 = float(fr3) / math.max(float(fRows), 1.0)
          let fFade = int(255.0 * (1.0 - 0.6 * fAge01)) ?? 200
          let fOutline = color.withAlpha(fCol, int(float(fFade) * 0.75) ?? 150)
          let fSolid = color.withAlpha(fCol, int(float(fFade) * 0.65) ?? 130)
          let fClear = color.withAlpha(fCol, 0)
          let fTxt = str.format("{0}/{1}", num(fHit), num(fAdd))
          let fTxW = textW(fTxt, fFont)
          let fTx = fIsBid ? fX0 + 4.0 : fX0 + fTw - 4.0 - fTxW
          let fTy = fy1 + math.max((fy2 - fy1) - fFont * 1.2, 0.0) / 2.0
          if fPerp {
            if fAdd > 0.0 {
              uFlow.get("h", fKey).set(x1: fAx1, y1: yP(fy1), x2: fAx2, y2: yP(fy2), color: fClear, borderWidth: fAdd > fFullBtc ? 2.5 : 1.0, borderColor: fOutline, zIndex: 1)
            } else {
              uFlow.delete("h", fKey)
            }
            if fHit > 0.0 && showHits {
              uFlow.get("a", fKey).set(x1: fHx1, y1: yP(fyA1), x2: fHx2, y2: yP(fyA2), color: fSolid, zIndex: 2)
            } else {
              uFlow.delete("a", fKey)
            }
            uFlab.get("n", fKey).set(x: fTx, y: yP(fTy), text: fTxt, color: fOutline, size: fFont, font: font.mono, zIndex: 3)
          } else {
            if fAdd > 0.0 {
              sFlow.get("h", fKey).set(x1: fAx1, y1: yS(fy1), x2: fAx2, y2: yS(fy2), color: fClear, borderWidth: fAdd > fFullBtc ? 2.5 : 1.0, borderColor: fOutline, zIndex: 1)
            } else {
              sFlow.delete("h", fKey)
            }
            if fHit > 0.0 && showHits {
              sFlow.get("a", fKey).set(x1: fHx1, y1: yS(fyA1), x2: fHx2, y2: yS(fyA2), color: fSolid, zIndex: 2)
            } else {
              sFlow.delete("a", fKey)
            }
            sFlab.get("n", fKey).set(x: fTx, y: yS(fTy), text: fTxt, color: fOutline, size: fFont, font: font.mono, zIndex: 3)
          }
        }
      }
    }
  }

  // ---- verdict windows from the ring buffers ----
  let wB0 = 0.0
  let wS0 = 0.0
  let wBp0 = 0.0
  let wSp0 = 0.0
  let wBA0 = 0.0
  let wBP0 = 0.0
  let wAA0 = 0.0
  let wAP0 = 0.0
  let wB1 = 0.0
  let wS1 = 0.0
  let wBp1 = 0.0
  let wSp1 = 0.0
  let wBA1 = 0.0
  let wBP1 = 0.0
  let wAA1 = 0.0
  let wAP1 = 0.0
  let pxNew0 = 0.0
  let pxOld0 = 0.0
  let pxNew1 = 0.0
  let pxOld1 = 0.0
  let ageNew0 = 999.0
  let ageOld0 = -1.0
  let ageNew1 = 999.0
  let ageOld1 = -1.0
  let pxVen0 = -1
  let pxVen1 = -1
  let wWin = float(winS)
  for wv in 0..8 {
    let wSpot = wv >= 4
    for wk in 0..120 {
      let wi = wv * 120 + wk
      let wst = rSec[wi] ?? 0.0
      let wage = dSec - wst
      if wst > 0.0 && wage >= 0.0 && wage < 2.0 * wWin {
        let wCur = wage < wWin
        let wb = rBuy[wi] ?? 0.0
        let ws = rSell[wi] ?? 0.0
        let wpx = rPx[wi] ?? 0.0
        if wSpot {
          if wCur {
            wB1 += wb
            wS1 += ws
            wBA1 += rBA[wi] ?? 0.0
            wBP1 += rBP[wi] ?? 0.0
            wAA1 += rAA[wi] ?? 0.0
            wAP1 += rAP[wi] ?? 0.0
            if wpx > 0.0 && (pxVen1 < 0 || pxVen1 == wv) {
              pxVen1 = wv
              if wage < ageNew1 {
                ageNew1 = wage
                pxNew1 = wpx
              }
              if wage > ageOld1 {
                ageOld1 = wage
                pxOld1 = wpx
              }
            }
          } else {
            wBp1 += wb
            wSp1 += ws
          }
        } else {
          if wCur {
            wB0 += wb
            wS0 += ws
            wBA0 += rBA[wi] ?? 0.0
            wBP0 += rBP[wi] ?? 0.0
            wAA0 += rAA[wi] ?? 0.0
            wAP0 += rAP[wi] ?? 0.0
            if wpx > 0.0 && (pxVen0 < 0 || pxVen0 == wv) {
              pxVen0 = wv
              if wage < ageNew0 {
                ageNew0 = wage
                pxNew0 = wpx
              }
              if wage > ageOld0 {
                ageOld0 = wage
                pxOld0 = wpx
              }
            }
          } else {
            wBp0 += wb
            wSp0 += ws
          }
        }
      }
    }
  }
  let vdU = judge(wB0, wS0, wBp0, wSp0, wBA0, wBP0, wAA0, wAP0, pxNew0 - pxOld0, perpHeavy, pxVen0 >= 0 && ageOld0 > ageNew0, px)
  let vdS = judge(wB1, wS1, wBp1, wSp1, wBA1, wBP1, wAA1, wAP1, pxNew1 - pxOld1, spotHeavy, pxVen1 >= 0 && ageOld1 > ageNew1, px)

  netU = uBuy - uSell
  netS = sBuy - sSell
  let dim = color.withAlpha(textCol, 90)
  let bgCol = color.withAlpha(textCol, 22)

  // ---- PERP HUD ----
  if uOn {
    let uUnit = uW / 2.0 * 0.9 / barFull
    let rU = math.abs(netU) / math.max(normU, sharkMin)
    let endU = uCx - math.clamp(netU / math.max(normU, sharkMin), -barFull, barFull) * uUnit
    let colU = netU >= 0.0 ? buyCol : sellCol
    uBox.get("bg").set(x1: uX0, y1: yP(66.0), x2: uX0 + uW, y2: yP(74.0), rounding: 4.0, color: bgCol)
    uBox.get("lean").set(x1: math.min(uCx, endU), y1: yP(66.0), x2: math.max(uCx, endU), y2: yP(74.0), rounding: 4.0, color: color.withAlpha(colU, rU >= 2.0 ? 255 : (rU >= 1.0 ? 200 : 120)))
    uLine.get("t1L").set(x1: uCx - uUnit, y1: yP(62.0), x2: uCx - uUnit, y2: yP(78.0), width: 1.0, color: dim)
    uLine.get("t1R").set(x1: uCx + uUnit, y1: yP(62.0), x2: uCx + uUnit, y2: yP(78.0), width: 1.0, color: dim)
    uLine.get("t2L").set(x1: uCx - 2.0 * uUnit, y1: yP(62.0), x2: uCx - 2.0 * uUnit, y2: yP(78.0), width: 1.0, color: dim)
    uLine.get("t2R").set(x1: uCx + 2.0 * uUnit, y1: yP(62.0), x2: uCx + 2.0 * uUnit, y2: yP(78.0), width: 1.0, color: dim)
    uLine.get("midV").set(x1: uCx, y1: yP(80.0), x2: uCx, y2: yP(uBottom), width: 1.0, color: dim, style: linestyle.dashed)
    uLine.get("laneL").set(x1: uCx - 6.0 - laneWP, y1: yP(80.0), x2: uCx - 6.0 - laneWP, y2: yP(uBottom), width: 1.0, color: color.withAlpha(textCol, 35), style: linestyle.dotted)
    uLine.get("laneR").set(x1: uCx + 6.0 + laneWP, y1: yP(80.0), x2: uCx + 6.0 + laneWP, y2: yP(uBottom), width: 1.0, color: color.withAlpha(textCol, 35), style: linestyle.dotted)
    let uBuyTxt = str.format("PERP BUYS {0} ({1})", num(uBuy), nUB)
    let uSellTxt = str.format("({0}) {1} PERP SELLS", nUS, num(uSell))
    let uNetTxt = str.format("{0}net {1}  {2:.1}x", rU >= 2.0 ? "OUTSIZED " : "", signedAmt(netU, px), rU)
    uHud.get("buy").set(x: uX0 + 8.0, y: yP(50.0), text: uBuyTxt, color: buyCol, size: 11.0)
    uHud.get("sell").set(x: uX0 + uW - 8.0 - textW(uSellTxt, 11.0), y: yP(50.0), text: uSellTxt, color: sellCol, size: 11.0)
    uHud.get("net").set(x: uCx - textW(uNetTxt, 11.0) / 2.0, y: yP(50.0), text: uNetTxt, color: rU >= 2.0 ? colU : textCol, size: 11.0)
    let vcU = vdU.tone > 0 ? buyCol : (vdU.tone < 0 ? sellCol : dim)
    if showVerdict {
      let uVw = textW(vdU.word, 16.0)
      if vdU.strong && vdU.tone != 0 {
        // strong: inverted - filled box in the verdict colour, text in the chart background colour
        uBox.get("vbox").set(x1: uCx - uVw / 2.0 - 12.0, y1: yP(4.0), x2: uCx + uVw / 2.0 + 12.0, y2: yP(28.0), rounding: 4.0, color: color.withAlpha(vcU, 235), zIndex: 6)
        uHud.get("verdict").set(x: uCx - uVw / 2.0, y: yP(7.0), text: vdU.word, color: pinCol, size: 16.0, zIndex: 7)
      } else {
        uBox.delete("vbox")
        uHud.get("verdict").set(x: uCx - uVw / 2.0, y: yP(7.0), text: vdU.word, color: vcU, size: 16.0)
      }
      uHud.get("vstats").set(x: uCx - textW(vdU.stats, 10.0) / 2.0, y: yP(34.0), text: vdU.stats, color: dim, size: 10.0)
    } else {
      uBox.delete("vbox")
      uHud.delete("verdict")
      uHud.delete("vstats")
    }
    let uVen = str.concat(venTxt(0, pV1, now), "   ", venTxt(1, pV2, now))
    uHud.get("ven").set(x: uCx - textW(uVen, 9.0) / 2.0, y: yP(perpV - 34.0), text: uVen, color: dim, size: 9.0)
  } else {
    uBox.delete("bg")
    uBox.delete("lean")
    uBox.delete("vbox")
    uLine.delete("t1L")
    uLine.delete("t1R")
    uLine.delete("t2L")
    uLine.delete("t2R")
    uLine.delete("midV")
    uLine.delete("laneL")
    uLine.delete("laneR")
    uHud.delete("buy")
    uHud.delete("sell")
    uHud.delete("net")
    uHud.delete("verdict")
    uHud.delete("vstats")
    uHud.delete("ven")
  }

  // ---- SPOT HUD ----
  if sOn {
    let sUnit = sW / 2.0 * 0.9 / barFull
    let rS = math.abs(netS) / math.max(normS, sharkMin)
    let endS = sCx - math.clamp(netS / math.max(normS, sharkMin), -barFull, barFull) * sUnit
    let colS = netS >= 0.0 ? buyCol : sellCol
    sBox.get("bg").set(x1: sX0, y1: yS(66.0), x2: sX0 + sW, y2: yS(74.0), rounding: 4.0, color: bgCol)
    sBox.get("lean").set(x1: math.min(sCx, endS), y1: yS(66.0), x2: math.max(sCx, endS), y2: yS(74.0), rounding: 4.0, color: color.withAlpha(colS, rS >= 2.0 ? 255 : (rS >= 1.0 ? 200 : 120)))
    sLine.get("t1L").set(x1: sCx - sUnit, y1: yS(62.0), x2: sCx - sUnit, y2: yS(78.0), width: 1.0, color: dim)
    sLine.get("t1R").set(x1: sCx + sUnit, y1: yS(62.0), x2: sCx + sUnit, y2: yS(78.0), width: 1.0, color: dim)
    sLine.get("t2L").set(x1: sCx - 2.0 * sUnit, y1: yS(62.0), x2: sCx - 2.0 * sUnit, y2: yS(78.0), width: 1.0, color: dim)
    sLine.get("t2R").set(x1: sCx + 2.0 * sUnit, y1: yS(62.0), x2: sCx + 2.0 * sUnit, y2: yS(78.0), width: 1.0, color: dim)
    sLine.get("midV").set(x1: sCx, y1: yS(80.0), x2: sCx, y2: yS(sBottom), width: 1.0, color: dim, style: linestyle.dashed)
    sLine.get("laneL").set(x1: sCx - 6.0 - laneWS, y1: yS(80.0), x2: sCx - 6.0 - laneWS, y2: yS(sBottom), width: 1.0, color: color.withAlpha(textCol, 35), style: linestyle.dotted)
    sLine.get("laneR").set(x1: sCx + 6.0 + laneWS, y1: yS(80.0), x2: sCx + 6.0 + laneWS, y2: yS(sBottom), width: 1.0, color: color.withAlpha(textCol, 35), style: linestyle.dotted)
    let sBuyTxt = str.format("SPOT BUYS {0} ({1})", num(sBuy), nSB)
    let sSellTxt = str.format("({0}) {1} SPOT SELLS", nSS, num(sSell))
    let sNetTxt = str.format("{0}net {1}  {2:.1}x", rS >= 2.0 ? "OUTSIZED " : "", signedAmt(netS, px), rS)
    sHud.get("buy").set(x: sX0 + 8.0, y: yS(50.0), text: sBuyTxt, color: buyCol, size: 11.0)
    sHud.get("sell").set(x: sX0 + sW - 8.0 - textW(sSellTxt, 11.0), y: yS(50.0), text: sSellTxt, color: sellCol, size: 11.0)
    sHud.get("net").set(x: sCx - textW(sNetTxt, 11.0) / 2.0, y: yS(50.0), text: sNetTxt, color: rS >= 2.0 ? colS : textCol, size: 11.0)
    let vcS = vdS.tone > 0 ? buyCol : (vdS.tone < 0 ? sellCol : dim)
    if showVerdict {
      let sVw = textW(vdS.word, 16.0)
      if vdS.strong && vdS.tone != 0 {
        // strong: inverted - filled box in the verdict colour, text in the chart background colour
        sBox.get("vbox").set(x1: sCx - sVw / 2.0 - 12.0, y1: yS(4.0), x2: sCx + sVw / 2.0 + 12.0, y2: yS(28.0), rounding: 4.0, color: color.withAlpha(vcS, 235), zIndex: 6)
        sHud.get("verdict").set(x: sCx - sVw / 2.0, y: yS(7.0), text: vdS.word, color: pinCol, size: 16.0, zIndex: 7)
      } else {
        sBox.delete("vbox")
        sHud.get("verdict").set(x: sCx - sVw / 2.0, y: yS(7.0), text: vdS.word, color: vcS, size: 16.0)
      }
      sHud.get("vstats").set(x: sCx - textW(vdS.stats, 10.0) / 2.0, y: yS(34.0), text: vdS.stats, color: dim, size: 10.0)
    } else {
      sBox.delete("vbox")
      sHud.delete("verdict")
      sHud.delete("vstats")
    }
    let sVen = str.concat(venTxt(4, sV1, now), "   ", venTxt(5, sV2, now))
    sHud.get("ven").set(x: sCx - textW(sVen, 9.0) / 2.0, y: yS(spotV - 34.0), text: sVen, color: dim, size: 9.0)
  } else {
    sBox.delete("bg")
    sBox.delete("lean")
    sBox.delete("vbox")
    sLine.delete("t1L")
    sLine.delete("t1R")
    sLine.delete("t2L")
    sLine.delete("t2R")
    sLine.delete("midV")
    sLine.delete("laneL")
    sLine.delete("laneR")
    sHud.delete("buy")
    sHud.delete("sell")
    sHud.delete("net")
    sHud.delete("verdict")
    sHud.delete("vstats")
    sHud.delete("ven")
    sHud.delete("l1")
    sHud.delete("l2")
  }

  // ---- card: one row across the bottom of the whole pane (both tanks keep equal height) ----
  let wF = totFish - (snapFish[0] ?? totFish)
  let wSh = totShark - (snapShark[0] ?? totShark)
  let wO = totOrca - (snapOrca[0] ?? totOrca)
  let wBl = totBlue - (snapBlue[0] ?? totBlue)
  let wB = totBuy - (snapBuy[0] ?? totBuy)
  let wS = totSell - (snapSell[0] ?? totSell)
  let buyPct = (wB + wS) > 0.0 ? 100.0 * wB / (wB + wS) : 50.0
  let line1 = str.format("last 5 bars   fish {0}   shark {1}   orca {2}   blue {3}", int(wF) ?? 0, int(wSh) ?? 0, int(wO) ?? 0, int(wBl) ?? 0)
  let line2 = str.format("vol {0:.1}x   buyers {1}%   {2}   biggest {3}", volX, int(buyPct) ?? 50, skyWord(skyX), amt(bigOn, px))
  // centred as one row (MMT's logo sits in the bottom-left corner)
  let cW1 = textW(line1, 11.0)
  let cW2 = textW(line2, 11.0)
  let cX1 = tankW / 2.0 - (cW1 + 30.0 + cW2) / 2.0
  cHud.get("l1").set(x: cX1, y: perpV - 18.0, text: line1, color: textCol, size: 11.0)
  cHud.get("l2").set(x: cX1 + cW1 + 30.0, y: perpV - 18.0, text: line2, color: buyPct >= 55.0 ? buyCol : (buyPct <= 45.0 ? sellCol : textCol), size: 11.0)
}

// ----- Tapes: prints -> bubbles, fill add-back; book diff once per second -----
// The book read is inline because a book view cannot be passed to a fn.
on tp1.trade(tr) {
  if pU1 {
    onPrint(0, tr.time, tr.price, tr.size, tr.isBuy)
    if wantCheck(0, tr.time) {
      clearNew(0)
      let bv = bp1.bids()
      let av = bp1.asks()
      vBookT[0] = float(time.unixSeconds(bp1.time()) ?? 0)
      if bv != null {
        for j in 0..binsEach {
          let lvl = bv.get(j)
          if lvl != null { putLv(0, 0, j, lvl.price, lvl.qty) }
        }
      }
      if av != null {
        for j in 0..binsEach {
          let lvl = av.get(j)
          if lvl != null { putLv(0, 1, j, lvl.price, lvl.qty) }
        }
      }
      diffVenue(0, bp1.binSize() ?? 0.0)
    }
  }
}
on tp2.trade(tr) {
  if pU2 {
    onPrint(1, tr.time, tr.price, tr.size, tr.isBuy)
    if wantCheck(1, tr.time) {
      clearNew(1)
      let bv = bp2.bids()
      let av = bp2.asks()
      vBookT[1] = float(time.unixSeconds(bp2.time()) ?? 0)
      if bv != null {
        for j in 0..binsEach {
          let lvl = bv.get(j)
          if lvl != null { putLv(1, 0, j, lvl.price, lvl.qty) }
        }
      }
      if av != null {
        for j in 0..binsEach {
          let lvl = av.get(j)
          if lvl != null { putLv(1, 1, j, lvl.price, lvl.qty) }
        }
      }
      diffVenue(1, bp2.binSize() ?? 0.0)
    }
  }
}
on ts1.trade(tr) {
  if sU1 {
    onPrint(4, tr.time, tr.price, tr.size, tr.isBuy)
    if wantCheck(4, tr.time) {
      clearNew(4)
      let bv = bs1.bids()
      let av = bs1.asks()
      vBookT[4] = float(time.unixSeconds(bs1.time()) ?? 0)
      if bv != null {
        for j in 0..binsEach {
          let lvl = bv.get(j)
          if lvl != null { putLv(4, 0, j, lvl.price, lvl.qty) }
        }
      }
      if av != null {
        for j in 0..binsEach {
          let lvl = av.get(j)
          if lvl != null { putLv(4, 1, j, lvl.price, lvl.qty) }
        }
      }
      diffVenue(4, bs1.binSize() ?? 0.0)
    }
  }
}
on ts2.trade(tr) {
  if sU2 {
    onPrint(5, tr.time, tr.price, tr.size, tr.isBuy)
    if wantCheck(5, tr.time) {
      clearNew(5)
      let bv = bs2.bids()
      let av = bs2.asks()
      vBookT[5] = float(time.unixSeconds(bs2.time()) ?? 0)
      if bv != null {
        for j in 0..binsEach {
          let lvl = bv.get(j)
          if lvl != null { putLv(5, 0, j, lvl.price, lvl.qty) }
        }
      }
      if av != null {
        for j in 0..binsEach {
          let lvl = av.get(j)
          if lvl != null { putLv(5, 1, j, lvl.price, lvl.qty) }
        }
      }
      diffVenue(5, bs2.binSize() ?? 0.0)
    }
  }
}

// ----- Water depth + sky (5m bars, so they exist on load) -----
on m5.close {
  let v15 = ta.sma(m5.volume, 3) ?? 0.0
  let v24 = ta.sma(m5.volume, 288) ?? 0.0
  volX = v24 > 0.0 ? v15 / v24 : 0.0
  let c0 = m5.close ?? 0.0
  let c1 = m5.close[1] ?? c0
  let ret = (c0 > 0.0 && c1 > 0.0) ? (math.log(c0 / c1) ?? 0.0) : 0.0
  let rvol = ta.stdev(ret, 12) ?? 0.0
  let rv24 = ta.sma(rvol, 288) ?? 0.0
  skyX = rv24 > 0.0 ? rvol / rv24 : 0.0
}

// ----- Draw: once per eval, live only -----
on chart.update {
  pinPLo.plot(0.0)
  pinPHi.plot(1.0)
  tankInit()
  // isLast as well: MMT can leave isHistory set on the live bar of a chart whose other scripts keep loading history
  if chart.isHistory == false || chart.isLast {
    tankDraw(chart.forming.close ?? (chart.close ?? 0.0))
  }
}

on chart.close {
  snapFish.push(totFish)
  snapShark.push(totShark)
  snapOrca.push(totOrca)
  snapBlue.push(totBlue)
  snapBuy.push(totBuy)
  snapSell.push(totSell)
}
