script "Positioning: NL / NS"

// Two panes: Net Longs / Net Shorts change per bar (OI change is a separate script).
//
// Per bar, with dOI = open-interest change and D = buy volume - sell volume:
//   Net Longs  change  NL = (dOI + D) / 2
//   Net Shorts change  NS = (dOI - D) / 2
// (NL + NS = dOI, NL - NS = D.) These are derived, not exchange-reported
// position counts, so treat them as an estimate. OI and volume must be in
// the same unit; use the multiply toggles if one is in coins and the other
// in quote currency.

data (
  chart = subscribe(data.ohlcv)
  oi    = subscribe(data.oi)
)

input (
  deltaTimesPrice = input.bool(true, title: "Multiply volume delta by price")
  oiTimesPrice    = input.bool(true, title: "Multiply OI change by price")
  showLabels      = input.bool(true, title: "Show bar values")
  labelSize       = input.float(9.0, title: "Label size", min: 4.0, max: 24.0)
  nlColor         = input.color(color.rgb(38, 166, 91), title: "NL increase")
  nsColor         = input.color(color.rgb(214, 72, 72), title: "NS increase")
  offColor        = input.color(color.rgb(112, 118, 126), title: "Decrease / closing")
)

pane (
  nlPane = pane(title: "NL - Net Longs Δ", height: 0.16)
  nsPane = pane(title: "NS - Net Shorts Δ", height: 0.16)
)

plot (
  nlHist = plot.histogram(title: "NL Δ", on: nlPane)
  nlLbl  = plot.label(title: "NL value", on: nlPane)
  nsHist = plot.histogram(title: "NS Δ", on: nsPane)
  nsLbl  = plot.label(title: "NS value", on: nsPane)
)

fn fmtVol(v: float) -> string {
  let a = math.abs(v)
  if a >= 1000000000.0 { return str.format("{0:.2}B", v / 1000000000.0) }
  if a >= 1000000.0 { return str.format("{0:.1}M", v / 1000000.0) }
  if a >= 10000.0 { return str.format("{0}k", int(math.round(v / 1000.0)) ?? 0) }
  if a >= 1000.0 { return str.format("{0:.1}k", v / 1000.0) }
  if a >= 100.0 { return str.format("{0}", int(math.round(v)) ?? 0) }
  if a >= 10.0 { return str.format("{0:.1}", v) }
  return str.format("{0:.2}", v)
}

on chart.update {
  let bv = chart.buyVolume
  let sv = chart.sellVolume
  let oiOpen = oi.forming.open
  let oiClose = oi.forming.close
  let px = chart.close
  if bv != null && sv != null && oiOpen != null && oiClose != null && px != null {
    let delta0 = bv - sv
    let dOi0 = oiClose - oiOpen
    let delta = deltaTimesPrice ? delta0 * px : delta0
    let dOi = oiTimesPrice ? dOi0 * px : dOi0

    let nl = (dOi + delta) * 0.5
    let ns = (dOi - delta) * 0.5

    nlHist.plot(nl, color: nl >= 0.0 ? nlColor : offColor)
    nsHist.plot(ns, color: ns >= 0.0 ? nsColor : offColor)

    if showLabels {
      nlLbl.plot(nl, fmtVol(nl), color: nl >= 0.0 ? nlColor : offColor, size: labelSize)
      nsLbl.plot(ns, fmtVol(ns), color: ns >= 0.0 ? nsColor : offColor, size: labelSize)
    }
  }
}
