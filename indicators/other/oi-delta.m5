script "OI Delta"

// Open-interest change per bar as a histogram (grey up, red down),
// with the bar value labelled and the current OI level in the pane title.

data (
  chart = subscribe(data.ohlcv)
  oi    = subscribe(data.oi)
)

input (
  oiTimesPrice = input.bool(true, title: "Multiply OI change by price")
  showLabels   = input.bool(true, title: "Show bar values")
  labelSize    = input.float(9.0, title: "Label size", min: 4.0, max: 24.0)
  upColor      = input.color(color.rgb(112, 118, 126), title: "OI increase")
  downColor    = input.color(color.rgb(214, 72, 72), title: "OI decrease")
)

pane (
  oiPane = pane(title: "OI - Open Interest Δ", height: 0.16)
)

plot (
  oiHist = plot.histogram(title: "OI Δ", on: oiPane)
  oiLbl  = plot.label(title: "OI value", on: oiPane)
)

fn fmtVol(v: float) -> string {
  let a = math.abs(v)
  if a >= 1000000000.0 { return str.format("{0:.2}B", v / 1000000000.0) }
  if a >= 1000000.0 { return str.format("{0:.1}M", v / 1000000.0) }
  if a >= 10000.0 { return str.format("{0}k", int(math.round(v / 1000.0)) ?? 0) }
  if a >= 1000.0 { return str.format("{0:.1}k", v / 1000.0) }
  if a >= 100.0 { return str.format("{0}", int(math.round(v)) ?? 0) }
  if a >= 10.0 { return str.format("{0:.1}", v) }
  return str.format("{0:.2}", v)
}

on chart.update {
  let oiOpen = oi.forming.open
  let oiClose = oi.forming.close
  let px = chart.close
  if oiOpen != null && oiClose != null && px != null {
    let dOi0 = oiClose - oiOpen
    let dOi = oiTimesPrice ? dOi0 * px : dOi0
    let oiLevel = oiTimesPrice ? oiClose * px : oiClose

    oiHist.plot(dOi, color: dOi >= 0.0 ? upColor : downColor)
    if showLabels {
      oiLbl.plot(dOi, fmtVol(dOi), color: dOi >= 0.0 ? upColor : downColor, size: labelSize)
    }
    oiPane.setTitle(str.format("OI - Open Interest Δ   (OI {0})", fmtVol(oiLevel)))
  }
}
