script "Value Area Levels"

// Previous-day VAH / VAL / POC as dashed rays at the live edge (like the
// "vah" tag on the reference chart), plus a rolling-profile VAH / VAL / POC
// that updates every bar.

data (
  chart = subscribe(data.ohlcv)
  vol   = subscribe(data.volume)
  daily = subscribe(data.volume, timeframe: 1D, history: 10)
)

input (
  vaPct     = input.float(70.0, title: "Value area %", min: 50.0, max: 95.0)
  showPrev  = input.bool(true, title: "Previous day VAH / VAL / POC")
  showRoll  = input.bool(false, title: "Rolling profile VAH / VAL / POC")
  rollBars  = input.int(96, title: "Rolling profile bars", min: 2, max: 2000)
  extendBy  = input.int(3, title: "Label offset from last bar (bars)", min: 1, max: 500)
  prevColor = input.color(color.rgb(225, 228, 232), title: "Previous day lines")
  pocColor  = input.color(color.rgb(255, 213, 79), title: "Rolling POC")
  vaColor   = input.color(color.rgb(45, 212, 191), title: "Rolling VAH / VAL")
)

state (
  lines  = entities.linePool(max: 3)
  labels = entities.labelPool(max: 3)
)

plot (
  rPoc = plot.line(title: "Rolling POC", width: 1.5)
  rVah = plot.line(title: "Rolling VAH")
  rVal = plot.line(title: "Rolling VAL")
)

fn ray(key: string, x1: time, x2: time, y: float, tag: string, c: color) {
  lines.get(key).set(
    x1: x1,
    y1: y,
    x2: x2,
    y2: y,
    color: c,
    width: 1.0,
    style: linestyle.dashed,
    extend: extend.right,
  )
  labels.get(key).set(
    x: x2,
    y: y,
    text: tag,
    color: c,
    size: 11.0,
  )
}

on chart.close {
  let gap: float? = null
  if showRoll {
    let profile = vol.profile(bars: rollBars)
    let area = profile.valueArea(vaPct)
    rPoc.plot(area != null ? area.pocPrice : gap, color: pocColor)
    rVah.plot(area != null ? area.highPrice : gap, color: vaColor)
    rVal.plot(area != null ? area.lowPrice : gap, color: vaColor)
  } else {
    rPoc.plot(gap)
    rVah.plot(gap)
    rVal.plot(gap)
  }
}

on chart.update {
  // Other subscriptions read their last COMPLETED period here, so the
  // daily profile is the previous UTC day.
  if chart.isLast && showPrev {
    let area = daily.valueArea(vaPct)
    let t = chart.time ?? time.fromUnixSeconds(0)
    if area != null {
      let start = time.dayStart(t)
      let end = t + time.bars(extendBy)
      ray("pvah", start, end, area.highPrice, "pd-vah", prevColor)
      ray("pval", start, end, area.lowPrice, "pd-val", prevColor)
      ray("ppoc", start, end, area.pocPrice, "pd-poc", prevColor)
    }
  }
}
